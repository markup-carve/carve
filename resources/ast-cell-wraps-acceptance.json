{
  "version": 1,
  "rows": [
    {
      "id": "code-span-crosses-a-join",
      "source": "| `a | z |\n+ b` | w |\n",
      "path": "/children/0/rows/0/cells/0/children/0",
      "expected": { "type": "code", "value": "a | z b", "cellWraps": [{ "offset": 5, "line": 1 }] }
    },
    {
      "id": "raw-inline-crosses-a-join",
      "source": "| `<b | z |\n+ c>`{=html} | w |\n",
      "path": "/children/0/rows/0/cells/0/children/0",
      "expected": { "type": "raw_inline", "format": "html", "content": "<b | z c>", "cellWraps": [{ "offset": 6, "line": 1 }] }
    },
    {
      "id": "inline-math-crosses-a-join",
      "source": "| $`a | z |\n+ b` | w |\n",
      "path": "/children/0/rows/0/cells/0/children/0",
      "expected": { "type": "math", "display": false, "content": "a | z b", "cellWraps": [{ "offset": 5, "line": 1 }] }
    },
    {
      "id": "code-span-skips-an-empty-plus-line",
      "source": "| `a |\n+ |\n+ b` |\n",
      "path": "/children/0/rows/0/cells/0/children/0",
      "continuationLines": 2,
      "expected": { "type": "code", "value": "a b", "cellWraps": [{ "offset": 1, "line": 2 }] }
    },
    {
      "id": "code-span-join-after-the-opener-stripped-as-padding",
      "source": "| ` |\n+ b ` |\n",
      "path": "/children/0/rows/0/cells/0/children/0",
      "expected": { "type": "code", "value": "b", "cellWraps": [{ "offset": 0, "line": 1 }] }
    },
    {
      "id": "code-span-join-before-the-closer-stripped-as-padding",
      "source": "| ` a |\n+ ` |\n",
      "path": "/children/0/rows/0/cells/0/children/0",
      "expected": { "type": "code", "value": "a", "cellWraps": [{ "offset": 1, "line": 1 }] }
    },
    {
      "id": "code-span-interior-join-beside-padding-names-its-space",
      "source": "| ` a |\n+ b ` |\n",
      "path": "/children/0/rows/0/cells/0/children/0",
      "expected": { "type": "code", "value": "a b", "cellWraps": [{ "offset": 1, "line": 1 }] }
    },
    {
      "id": "join-between-nodes-takes-a-marker",
      "source": "| `x`{=html} a | z |\n+ b | w |\n",
      "path": "/children/0/rows/0/cells/0/children",
      "expected": [
        { "type": "raw_inline", "format": "html", "content": "x" },
        { "type": "text", "value": " a" },
        { "type": "cell_wrap", "line": 1 },
        { "type": "text", "value": "b" }
      ]
    }
  ]
}
