CarveCore {

  // ==========================================================================
  // Carve Core - the executable companion grammar (Ohm/PEG).
  //
  // ROLE. This file is the machine-interpretable proof for the CORE subset of
  // resources/grammar.ebnf: everything here is pure grammar - no prose
  // normativity. scripts/formal-core-check.mjs runs it against the
  // conformance corpus in CI fashion: a corpus input that this grammar
  // matches must render to the corpus HTML byte-for-byte.
  //
  // SCOPE (Core). This file owns the INLINE layer and the leaf blocks of
  // the executable spec. Blocks: ATX headings, thematic breaks, paragraphs,
  // fenced code. Inline: the seven bare emphasis delimiters (/ * _ ~ ^ = ,)
  // with the full PART 3 bare_opener/bare_closer word-boundary guards,
  // verbatim code spans, math ($/$$ + span), escapes, links (inline,
  // reference, collapsed), images, inline spans + attribute blocks,
  // autolinks (URL + email), footnote references, and crossrefs (</#id>).
  //
  // Container blocks (lists, block quotes, footnote definitions - the L0
  // layout automaton) live in scripts/spec/layout.mjs; resolution and
  // serialization (PART 9R / PART 10) in scripts/spec/html.mjs. Together
  // they form the executable spec that scripts/formal-core-check.mjs runs
  // against the corpus.
  //
  // DELIBERATELY OUT (Full Carve; the pipeline REFUSES rather than
  // approximates): tables (2D span walk), divs/admonitions, smart
  // typography, mentions/tags, inline extensions (:name[...]), emoji,
  // editorial markup, comments, block-attribute lines, definition lists,
  // citations, includes, frontmatter, inline footnotes (^[...]), and
  // multi-line heading folding.
  //
  // Word boundaries without lookbehind (PEGs have none):
  //  - left boundary / no-intraword: `word` absorbs a delimiter glued
  //    between two word chars (wordGlue), so an intraword delimiter can
  //    never open a run;
  //  - opener not followed by whitespace: negative lookahead;
  //  - closer not preceded by whitespace: an interior space may not sit
  //    directly before the closer (the spaceIn* rules);
  //  - closer not followed by an alphanumeric: negative lookahead;
  //  - a non-closing delimiter inside its own span is literal content
  //    (litSelf*), which realizes the nearest-valid-closer rule.
  //
  // The ONE Core rule a PEG cannot state: len(closer) >= len(opener) for
  // fences (a counting constraint - `where` guard in grammar.ebnf). The
  // checker asserts it as a documented semantic predicate.
  // ==========================================================================

  doc        = block*
  // start rule used by the executable-spec pipeline (scripts/spec/*): the
  // layout automaton owns block structure; this parses ONE line of inline
  // content. newline is not matchable here.
  inlines    = inline*
  // (lexical, lowercase: Ohm syntactic rules skip whitespace -- fatal for
  // an indentation-sensitive language)

  block      = blankLine
             | heading
             | thematicBreak
             | codeBlock
             | paragraph

  blankLine  = spaceChar* newline

  // --- Headings: 1-6 '#' at column 0, one space, inline text to EOL --------
  heading    = headingL<"######"> | headingL<"#####"> | headingL<"####">
             | headingL<"###"> | headingL<"##"> | headingL<"#">
  headingL<h> = h " " inline+ lineEnd &hBound<h>
  // A heading must be FOLLOWED by a blank line, a DIFFERENT-level heading,
  // another structural opener, or EOF. A plain line directly after a
  // heading, or a SAME-level `#` marker line, is djot-style multi-line
  // heading FOLDING -- Full Carve, not Core: the document fails to match
  // rather than mis-rendering as separate blocks.
  hBound<h>  = blankLine | (~(h " ") structural) | end
  hashes     = "######" | "#####" | "####" | "###" | "##" | "#"

  // --- Thematic break: a lone line of 3+ dashes/stars/underscores ----------
  thematicBreak = ("---" "-"* | "***" "*"* | "___" "_"*) lineEnd

  // --- Fenced code ----------------------------------------------------------
  codeBlock  = backtickFence | tildeFence
  backtickFence = btOpen langInfo? newline codeLine<btClose>* btClose
  tildeFence    = tdOpen langInfo? newline codeLine<tdClose>* tdClose
  btOpen     = "```" "`"*
  btClose    = "```" "`"* spaceChar* lineEnd
  tdOpen     = "~~~" "~"*
  tdClose    = "~~~" "~"* spaceChar* lineEnd
  langInfo   = spaceChar* langToken
  langToken  = langChar+
  langChar   = letter | digit | "-" | "_" | "+" | "#" | "." | "/"
  // only a closer of the OPEN fence's character ends the body: a `~~~`
  // line inside a backtick block (and vice versa) is ordinary content
  codeLine<closer> = ~closer (~newline any)* newline

  // --- Paragraph: 1+ lines of Core-only inline content ----------------------
  paragraph  = paraLine+
  paraLine   = ~blankLine ~structural inline+ lineEnd
  structural = headingStart | thematicBreak | btOpen | tdOpen
             | colonFence | ordMarker
  headingStart = hashes " "
  colonFence = ":::"
  // an ordered-list marker line (digit/letter run + `)` + space) is a
  // Full-Carve list: Core refuses the document rather than rendering a
  // paragraph. (The `.`-delimited form already fails: `.` is not a Core
  // character.)
  ordMarker  = alnumCh+ ")" " "

  // ==========================================================================
  // INLINE (Core)
  // ==========================================================================
  // ORDER IS TUNED FOR SPEED (byte-exactness preserved). The three most common
  // tokens -- `word`, `spComment`, `inlineSpace` -- are hoisted to the FRONT:
  // NO other alternative begins with an alphanumeric or a space, so hoisting
  // them cannot change which alternative wins, and it lets an alnum/space char
  // match in one attempt. `litDelim` stays after `arrow` and `span` (they claim
  // `=>` and `/*` first). This keeps the tokenizer's per-character work
  // near-constant, so the inline pass (with the SS9 delimiter stack) is O(n).
  inline     = word | spComment | inlineSpace
             | arrow | span | inlineNote | litDelim
             | symbol | footnoteRef | crossref | extension | symbolAttr | shortcode | mention | tag
             | editorial | forcedSpan
             | mathD | mathI | litInline | codeA | nbspEsc | hardBreak | escape | image | bracketed
             | autolink | bang | dollar
             | ellipsis | dashRun | dot | dash | plus | pct | lt | gt
             | dquote | squote | hash | looseAttrs | nl | other | anyChar
  // BARE EMPHASIS ($9 delimiter stack): the five bare delimiters / * _ ~ =
  // are NOT resolved by the PEG here. Each bare delimiter that is not glued
  // into a `word` (intraword absorption, below) or consumed by a leaf
  // construct falls through to `litDelim`, a single-char candidate token.
  // scripts/spec/render.mjs runs ONE left-to-right delimiter-stack pass
  // (grammar.ebnf PART 9 $9 E1-E5) over the token stream to pair openers and
  // closers, so run resolution is O(n) with NO backtracking. The bare
  // single-char span PEG productions (emph/strong/underline/strike/highlight,
  // and the delimRun same-delimiter-adjacency rule) were REMOVED; their job
  // now lives in the resolver. The bracing / forced / editorial constructs
  // and the combined /*...*/ bold_italic two-char token stay in the PEG.
  delimRun   = dRun<"/"> | dRun<"*"> | dRun<"_"> | dRun<"~"> | dRun<"^"> | dRun<"="> | dRun<",">
  dRun<d>    = d d+

  span       = boldItalic

  // Combined form /*x*/ -> <strong><em> (grammar.ebnf bold_italic); matched
  // before emph so the two-char token wins over nested /-then-* parsing.
  boldItalic = "/*" ~spaceOrEnd biInner+ "*/" attrs?
  biInner    = ~("*/") (rich | word | " " ~("*/") | litDelim | other)

  // constructs allowed inside any span (everything except spans themselves,
  // which are listed per-delimiter to exclude self-nesting)
  rich       = arrow | symbol | delimRun | inlineNote | footnoteRef | crossref | extension | symbolAttr | shortcode | mention | tag
             | editorial | forcedSpan | mathD | mathI
             | codeA | escape | image | bracketed | autolink | bang | dollar
             | ellipsis | dashRun | dquote | squote
             | dot | dash | plus | pct

  // The bare single-char span productions (emph/strong/underline/strike/
  // highlight with per-delimiter bare_opener/bare_closer word-boundary guards,
  // interior-space and litSelf helpers) previously lived here. They resolved
  // runs by PEG backtracking -- O(n^2) on a long run of unclosed openers. They
  // are now REPLACED by the O(n) delimiter-stack pass in scripts/spec/render.mjs
  // (grammar.ebnf PART 9 $9). A bare `/ * _ ~ =` reaches the resolver as a
  // `litDelim` candidate token; `^` and `,` have no bare span and stay literal.

  // Verbatim code span: equal-length maximal backtick runs (Core uses the
  // 1..3 tier; longer runs are out of Core). Single-space strip is applied
  // by the renderer per the code_span rule.
  codeA      = rawInline | codeAttrd
  codeAttrd  = code attrs?
  code       = code3 | code2 | code1 | codeU
  // UNCLOSED RUN (PART 3 code_span): an opener with no equal-run closer
  // ahead opens a verbatim span to the END OF BLOCK; opaque; no
  // single-space strip
  codeU      = "\u0060" "\u0060"* any*
  code1      = "`" (~"`" any)+ "`" ~"`"
  code2      = "``" (~"``" any)+ "``" ~"`"
  code3      = "```" (~"```" any)+ "```" ~"`"

  escape     = "\\" punctChar
  // escaped SPACE is a non-breaking space; a backslash at END OF LINE is a
  // hard break (PART 3)
  nbspEsc    = "\\" " "
  hardBreak  = "\\" &(newline | end)

  // --- Mentions and tags (PART 9 SS7): name = letters/digits/_/- with
  // INTERIOR dots; a trailing dot is punctuation. Word boundary on the
  // left is enforced by the word rule's atGlue/hashGlue absorption.
  mention    = "@" tagName
  tag        = "#" tagName
  tagName    = tagChar+ (tagDot tagChar+)*
  tagChar    = letter | digit | "_" | "-"
  tagDot     = "." &tagChar

  // --- Math (PART 3: `$` / `$$` + a verbatim span; bare `$` is literal) ---
  mathI      = "$" code attrs?
  mathD      = "$$" code attrs?

  // --- Inline literal (PART 9 SS27): "!" prefix on a verbatim code span,
  // mirroring math's "$" prefix. Content is HTML-escaped and emitted by every
  // renderer; the <code> wrapper is dropped. A trailing attribute block is the
  // ORDINARY code-span attribute block -- with attributes a <span> carries
  // them, with none bare escaped text is emitted. Tried before `image` and
  // `bang` in the inline alternation so `!` binds to a following backtick run.
  litInline  = "!" code attrs?

  // --- Cross-reference with auto text (PART 3 auto_text_link) -------------
  crossref   = "</#" xrefId ">"
  xrefId     = (~">" ~space ~newline any)+

  // --- Footnotes (PART 3; a bare `^` is literal, so `^[` is unambiguous) --
  footnoteRef = "[^" fnLabel "]" attrs?
  fnLabel    = (~"]" ~newline any)+
  inlineNote = "^[" brContent* "]" attrs?

  // --- Forced intraword spans {X...X} (PART 9 SS22) and editorial markup.
  // A same-type delimiter inside a forced span is literal until the `X}`
  // closer; other constructs nest normally.
  forcedSpan = forced<"/"> | forced<"*"> | forced<"_"> | forced<"~">
             | forced<"^"> | forced<","> | forced<"=">
  forced<d>  = "{" d fInner<d>* d "}" attrs?
  // `looseAttrs` is admitted so a nested bare span's trailing `{...}` attribute
  // block is consumed here (the removed bare-span rules used to grab it via
  // their `attrs?`); the SS9 stack over these tokens then re-attaches it.
  fInner<d>  = ~(d "}") (rich | span | word | spComment | inlineSpace | litDelim
             | looseAttrs | bang | dollar | ellipsis | dashRun | dot | dash | plus | pct
             | lt | gt | dquote | squote | hash | other)

  // editorial: {+ins+} {-del-} {~old~>new~} {# comment #} (+ the doubled
  // {++...++} / {--...--} forms whose extra marker chars stay literal)
  editorial  = edSub | edIns | edDel | edComment
  edIns      = "{+" (~"+}" edChar)* "+}" attrs?
  edDel      = "{-" (~"-}" edChar)* "-}" attrs?
  edSub      = "{~" (~"~>" ~"~}" edChar)* "~>" (~"~}" edChar)* "~}" attrs?
  edComment  = "{#" (~"#}" edChar)* "#}" attrs?
  edChar     = ~newline any

  // raw inline passthrough: a code span whose trailing block is EXACTLY
  // {=format} (PART 9 SS20)
  rawInline  = code "{=" ident "}"

  // --- Inline extensions: :name[content] -> ext span (PART 8 rank 9);
  // content ends at the FIRST unescaped "]" (corpus 16-5)
  extension  = ":" extName "[" extContent "]" attrs?
  extName    = identStart identRest*
  extContent = (escape | (~"]" ~newline any))*

  // An attributed symbol shortcode `:name:{...}` wraps in a <span> carrying
  // the attribute block. Core has no symbol map, so an UNMAPPED symbol resolves
  // to its literal text `:name:` as the span body (the same fallback as the
  // bare `shortcode` form). The attribute block is CONSUMED here so it attaches
  // to this span rather than the surrounding text. A bare `:name:` with no
  // attribute block stays literal text (see `shortcode`).
  symbolAttr = ":" shortcodeName ":" attrs
  // An UNattributed `:name:` shortcode. Core has no symbol map, so it renders
  // literally -- but it must still be CONSUMED as one token, or its inner
  // characters would fall through to smart typography (`:+-:` would become
  // `:±:` instead of the symbol `+-`). PART 9 §7: a symbol is recognized
  // before the typographic replacements.
  shortcode  = ":" shortcodeName ":" ~attrs

  // --- Bracketed constructs: link / image / span / reference link ---------
  // The single-char lookahead after `]` selects the construct (PART 9 S14);
  // a bare bracketed run with no tail is LITERAL text (rendered with its
  // content inline-parsed).
  bracketed  = "[" brContent* "]" brTail?
  brContent  = escape | code | nested | (~"]" ~newline any)
  nested     = "[" brContent* "]"
  brTail     = linkTail | refTail | attrs | emptyAttrs
  linkTail   = "(" dest destTitle? ")" attrs?
  refTail    = "[" refLabel? "]" attrs?
  refLabel   = (~"]" ~newline any)+
  dest       = destChar*
  destChar   = ~(")" | " " | "\t" | newline) any
  destTitle  = " "+ (quoted | squoted)
  squoted    = "'" sqChar* "'"
  sqChar     = sqEsc | (~"'" ~newline any)
  sqEsc      = "\\" "'"
  quoted     = "\"" qChar* "\""
  qChar      = qEsc | (~"\"" ~newline any)
  qEsc       = "\\" "\""

  image      = "!" "[" altText "]" "(" dest destTitle? ")" attrs?
  altText    = (~"]" ~newline any)*

  // --- Autolinks (PART 3): URL or email in angle brackets ------------------
  autolink   = "<" (urlBody | emailBody) ">" attrs?
  urlBody    = scheme ":" urlChar+
  scheme     = letter (letter | digit | "+" | "-" | ".")*
  emailBody  = emailLocal "@" (emailSeg ".")+ letter+
  emailLocal = emailChar+
  emailSeg   = (letter | digit | "-" | "_")+
  emailChar  = letter | digit | "-" | "_" | "." | "+"
  urlChar    = letter | digit | "-" | "." | "_" | "~" | ":" | "/" | "?"
             | "#" | "[" | "]" | "@" | "!" | "$" | "&" | "'" | "(" | ")"
             | "*" | "+" | "," | ";" | "=" | "%"

  // --- Attribute block (PART 4, strict identifiers) ------------------------
  attrs      = "{" attrSp* attrItem (attrSp+ attrItem)* attrSp* "}"
  emptyAttrs = "{" " "* "}"
  attrSp     = " " | "\n"
  attrItem   = idAttr | classAttr | kvAttr | boolAttr
  idAttr     = "#" ident
  classAttr  = "." ident
  kvAttr     = ident "=" attrVal
  boolAttr   = ident
  attrVal    = quoted | squoted | bareVal
  bareVal    = (~(" " | "}" | newline) any)+
  ident      = identStart identRest*
  identStart = letter | "_" | "-"
  identRest  = letter | digit | "_" | "-"

  // A word absorbs any bare delimiter glued between two word characters -
  // this IS the left word-boundary / no-intraword rule, structurally.
  word       = wordChar (wordChar | wordGlue | atGlue | hashGlue | colonGlue | dotGlue | pctGlue)*
  wordGlue   = delim &wordChar
  // absorb the `@`/`#`/`:` glued between word chars (me@example.com, a#b,
  // a:b:c, 10:30) and the intraword dot so none triggers mention / tag /
  // symbol / typography rules (the left word-boundary guard: a symbol only
  // opens at start or after a non-word char, matching @mention / #tag)
  atGlue     = "@" &wordChar
  hashGlue   = "#" &wordChar
  // absorb an intraword colon, but NOT one that opens an inline extension
  // (`a:kbd[x]`): extensions have no left-boundary restriction, so the
  // `:name[` opener must still reach the extension rule.
  colonGlue  = ":" ~(extName "[") &(wordChar | "+" | "-")
  dotGlue    = "." &wordChar
  // a %-run glued to a word is literal (50%%, a%%b) - never a comment
  pctGlue    = "%" "%"* &(wordChar | " " | end)
  // NOTE: a `_` glued to a word (e.g. `a_/b`) is NOT absorbed here -- it reaches
  // the resolver as a bare `litDelim` candidate. The bare_opener guard already
  // keeps a delimiter that FOLLOWS a `_` from opening (grammar.ebnf §9,
  // `prev === '_'` in bareOpener), and the `_` itself must stay a candidate so
  // it can CLOSE an open underline span (`_z_/y/` -> <u>z</u>/y/, matching the
  // engines + §9 close-first). A former `underGlue = "_" delim &wordChar` rule
  // swallowed that closing `_` into a text run and diverged.
  wordChar   = letter | digit
  delim      = "/" | "*" | "_" | "~" | "^" | "=" | ","

  // a whitespace-preceded %% consumes the rest of the LINE (SS21); the
  // space itself is consumed too
  spComment  = " " "%%" (~newline any)*
  inlineSpace = " "

  // A bare delimiter that opened nothing is literal text.
  litDelim   = delim
  bang       = "!" ~"["
  dollar     = "$" ~"`" ~"$"
  // single punctuation is plain text; RUNS that smart-typography or the
  // comment syntax would transform (`...`, `--`, `+-`, `%%`) are Full
  // Carve, so Core refuses them
  // a `<` that opens no autolink/crossref, and a bare `>`, are literal
  // text (HTML-escaped by the renderer)
  lt         = "<"
  gt         = ">"
  // SMART TYPOGRAPHY (PART 9 SS8). Multi-char patterns are consumed as
  // tokens; the open/close decision for quotes uses the previous source
  // character in the SEMANTICS (deterministic single-char lookbehind).
  arrow      = "<->" | "->" | "<-" | "=>" | "!=" | "<=" | ">=" | "+-"
  symbol     = "(c)" | "(r)" | "(tm)"
  ellipsis   = "..."
  dashRun    = "-" "-"+
  dquote     = "\""
  squote     = "'"
  // a bare `#` (not a tag opener: followed by space/colon/dot/end) is
  // literal - needed for caption number placeholders and prose
  hash       = "#" &(" " | ":" | "." | newline | end)
  dot        = "." ~".."
  dash       = "-" ~"-"
  plus       = "+" ~"-"
  pct        = "%" ~"%"

  // Core-safe plain characters. Everything NOT listed here and not handled
  // above (brackets, braces, quotes, $, <, >, !, %, dashes, dots, ...)
  // makes the line - and the document - fail to match: those constructs
  // exist in Full Carve, so Core refuses rather than mis-renders.
  other      = letter | digit | colon | ";" | "?" | "&" | "(" | ")" | at
  // catch-all: any remaining character is literal text (HTML-escaped; the
  // Trojan-Source bidi strip happens in escapeHtml). Constructs are all
  // tried first, so this only sees genuinely plain characters.
  anyChar    = ~newline any
  // paragraphs are inline-parsed as ONE text with embedded soft breaks
  nl         = "\n"
  // a valid-shaped attribute block with no abutting carrier is LITERAL
  // text (PART 9 SS14/SS15); an invalid payload still refuses
  looseAttrs = attrs
  // a `:` opening an inline extension (:name[...]) is Full Carve -> refuse;
  // a plain colon is text. A bare `:name:` symbol shortcode with no map is
  // literal text in Core, matching Full Carve's mapless fallback; the
  // attributed form `:name:{...}` is refused (see symbolAttr).
  colon      = ":" ~(ident "[")
  shortcodeName = (alnumCh | "+" | "-") (alnumCh | "_" | "+" | "-")*
  // a bare `@` followed by a word char is a mention (Full Carve) -> refuse;
  // an email-embedded `@` is absorbed by the word rule (atGlue)
  at         = "@" ~wordChar

  // --- Lexical ---------------------------------------------------------------
  punctChar  = "!" | "\"" | "#" | "$" | "%" | "&" | "'" | "(" | ")" | "*"
             | "+" | "," | "-" | "." | "/" | ":" | ";" | "<" | "=" | ">"
             | "?" | "@" | "[" | "\\" | "]" | "^" | "_" | "`" | "{" | "|"
             | "}" | "~"
  alnumCh    = letter | digit
  spaceChar  = " " | "\t"
  newline    = "\n" | "\r\n"
  lineEnd    = newline | end
  spaceOrEnd = " " | "\t" | newline | end
}
