CarveCore {

  // ==========================================================================
  // Carve Core - the executable companion grammar (Ohm/PEG).
  //
  // ROLE. This file is the machine-interpretable proof for the CORE subset of
  // resources/grammar.ebnf: everything here is pure grammar - no prose
  // normativity. scripts/formal-core-check.mjs runs it against the
  // conformance corpus in CI fashion: a corpus input that this grammar
  // matches must render to the corpus HTML byte-for-byte.
  //
  // PRECEDENCE. This file is DERIVED and resources/grammar.ebnf is normative;
  // where the two disagree, the production wins and this file is the defect.
  // See the NORMATIVITY block at the top of that file. Historically both were
  // described as "the two normative files", which is what let a disagreement
  // sit unresolved with each one deferring to the other (carve#912) - there
  // was no rule saying which was the language. There is now, and the
  // conformance direction is one-way: core:check asks whether this grammar
  // reproduces the committed corpus, never whether the corpus matches it.
  //
  // SCOPE (Core). This file owns the INLINE layer and the leaf blocks of
  // the executable spec. Blocks: ATX headings, thematic breaks, paragraphs,
  // fenced code. Inline: the seven bare emphasis delimiters (/ * _ ~ ^ = ,)
  // with the full PART 3 bare_opener/bare_closer word-boundary guards,
  // verbatim code spans, math ($/$$ + span), escapes, links (inline,
  // reference, collapsed), images, inline spans + attribute blocks,
  // autolinks (URL + email), footnote references, and crossrefs (</#id>).
  //
  // Container blocks (lists, block quotes, footnote definitions - the L0
  // layout automaton) live in scripts/spec/layout.mjs; resolution and
  // serialization (PART 9R / PART 10) in scripts/spec/html.mjs. Together
  // they form the executable spec that scripts/formal-core-check.mjs runs
  // against the corpus.
  //
  // DELIBERATELY OUT (Full Carve; the pipeline REFUSES rather than
  // approximates): tables (2D span walk), divs/admonitions, smart
  // typography, mentions/tags, inline extensions (:name[...]), emoji,
  // editorial markup, comments, block-attribute lines, definition lists,
  // citations, includes, frontmatter, and inline footnotes (^[...]).
  //
  // (Heading folding used to be listed here. It is gone from the language,
  // not just from this pipeline: a heading ends at its newline, §PART 2.)
  //
  // Word boundaries without lookbehind (PEGs have none):
  //  - left boundary / no-intraword: `word` absorbs a delimiter glued
  //    between two word chars (wordGlue), so an intraword delimiter can
  //    never open a run;
  //  - opener not followed by whitespace: negative lookahead;
  //  - closer not preceded by whitespace: an interior space may not sit
  //    directly before the closer (the spaceIn* rules);
  //  - closer not followed by an alphanumeric: negative lookahead;
  //  - a non-closing delimiter inside its own span is literal content
  //    (litSelf*), which realizes the nearest-valid-closer rule.
  //
  // The ONE Core rule a PEG cannot state: len(closer) >= len(opener) for
  // fences (a counting constraint - `where` guard in grammar.ebnf). The
  // checker asserts it as a documented semantic predicate.
  // ==========================================================================

  doc        = block*
  // start rule used by the executable-spec pipeline (scripts/spec/*): the
  // layout automaton owns block structure; this parses ONE line of inline
  // content. newline is not matchable here.
  inlines    = inline*
  // (lexical, lowercase: Ohm syntactic rules skip whitespace -- fatal for
  // an indentation-sensitive language)

  block      = blankLine
             | heading
             | thematicBreak
             | codeBlock
             | paragraph

  blankLine  = spaceChar* newline

  // --- Headings: 1-6 '#' at column 0, one space, inline text to EOL --------
  heading    = headingL<"######"> | headingL<"#####"> | headingL<"####">
             | headingL<"###"> | headingL<"##"> | headingL<"#">
  headingL<h> = h " " inline+ lineEnd
  // A heading ENDS AT THE NEWLINE and needs no boundary check: nothing folds
  // into it, so whatever follows simply begins its own block. The lookahead
  // this rule used to carry existed only to refuse djot-style folding, which
  // the language no longer has.
  hashes     = "######" | "#####" | "####" | "###" | "##" | "#"

  // --- Thematic break: a lone line of 3+ dashes/stars/underscores ----------
  thematicBreak = ("---" "-"* | "***" "*"* | "___" "_"*) lineEnd

  // --- Fenced code ----------------------------------------------------------
  codeBlock  = backtickFence | tildeFence
  backtickFence = btOpen langInfo? newline codeLine<btClose>* btClose
  tildeFence    = tdOpen langInfo? newline codeLine<tdClose>* tdClose
  btOpen     = "```" "`"*
  btClose    = "```" "`"* spaceChar* lineEnd
  tdOpen     = "~~~" "~"*
  tdClose    = "~~~" "~"* spaceChar* lineEnd
  // The slot before the info string is PADDING and takes `space`, matching
  // `fenced_code_block = code_fence_open, [space], [code_fence_info]` in
  // resources/grammar.ebnf. It said `spaceChar*` until carve#907, and
  // `spaceChar` is a space OR A TAB - so this file disagreed with the
  // production it implements at this one point, while every prose clause said
  // a tab is syntax only in a line's leading indentation run (PART 7).
  //
  // The caveat this comment used to carry - THIS RULE IS NOT EXECUTED - was
  // true and is not any more. scripts/spec/render.mjs still matches only
  // `inlines`, `attrs` and `blockAttrs`, so nothing in the RENDER pipeline
  // reaches `doc`, `block`, `codeBlock` or `langInfo`; but carve#916 added
  // tests/ohm-block-layer.test.mjs, which drives every block production as an
  // ohm start rule from a fixture table. Replacing this rule's body with a
  // literal that matches nothing now fails there, and so does widening it back
  // to `spaceChar*`. The TEXT pin in tests/separator-role-split.test.mjs stays
  // alongside it: it is what asserts this line and grammar.ebnf's carry the
  // same spelling.
  //
  // What is still NOT executed: `doc` is never run over a corpus document, so
  // nothing checks that this grammar and scripts/spec/layout.mjs model the
  // same language. That is carve#916's option 1 and it is still open.
  langInfo   = " "? langToken
  langToken  = langChar+
  langChar   = letter | digit | "-" | "_" | "+" | "#" | "." | "/"
  // only a closer of the OPEN fence's character ends the body: a `~~~`
  // line inside a backtick block (and vice versa) is ordinary content
  codeLine<closer> = ~closer (~newline any)* newline

  // --- Paragraph: 1+ lines of Core-only inline content ----------------------
  paragraph  = paraLine+
  paraLine   = ~blankLine ~structural inline+ lineEnd
  structural = headingStart | thematicBreak | btOpen | tdOpen
             | colonFence | ordMarker
  headingStart = hashes " "
  colonFence = ":::"
  // an ordered-list marker line (digit/letter run + `)` + space) is a
  // Full-Carve list: Core refuses the document rather than rendering a
  // paragraph. (The `.`-delimited form already fails: `.` is not a Core
  // character.)
  ordMarker  = alnumCh+ ")" " "

  // ==========================================================================
  // INLINE (Core)
  // ==========================================================================
  // ORDER IS TUNED FOR SPEED (byte-exactness preserved). The three most common
  // tokens -- `word`, `spComment`, `inlineSpace` -- are hoisted to the FRONT:
  // NO other alternative begins with an alphanumeric or a space, so hoisting
  // them cannot change which alternative wins, and it lets an alnum/space char
  // match in one attempt. `litDelim` stays after `arrow` and `span` (they claim
  // `=>` and `/*` first). This keeps the tokenizer's per-character work
  // near-constant, so the inline pass (with the SS9 delimiter stack) is O(n).
  inline     = word | spComment | inlineSpace
             | arrow | span | inlineNote | litDelim
             | symbol | footnoteRef | crossref | extension | symbolAttr | shortcode | mention | tag
             | editorial | forcedSpan
             | mathD | mathI | litInline | codeA | nbspEsc | hardBreak | escape | imageRef | image | bracketed
             | autolink | bang | dollar
             | ellipsis | dashRun | dot | dash | plus | pct | lt | gt
             | dquote | squote | hash | looseAttrs | nl | other | anyChar
  // BARE EMPHASIS ($9 delimiter stack): the five bare delimiters / * _ ~ =
  // are NOT resolved by the PEG here. Each bare delimiter that is not glued
  // into a `word` (intraword absorption, below) or consumed by a leaf
  // construct falls through to `litDelim`, a single-char candidate token.
  // scripts/spec/render.mjs runs ONE left-to-right delimiter-stack pass
  // (grammar.ebnf PART 9 $9 E1-E5) over the token stream to pair openers and
  // closers, so run resolution is O(n) with NO backtracking. The bare
  // single-char span PEG productions (emph/strong/underline/strike/highlight,
  // and the delimRun same-delimiter-adjacency rule) were REMOVED; their job
  // now lives in the resolver. The bracing / forced / editorial constructs
  // and the combined /*...*/ bold_italic two-char token stay in the PEG.
  delimRun   = dRun<"/"> | dRun<"*"> | dRun<"_"> | dRun<"~"> | dRun<"^"> | dRun<"="> | dRun<",">
  dRun<d>    = d d+

  span       = boldItalic

  // Combined form /*x*/ -> <strong><em> (grammar.ebnf bold_italic); matched
  // before emph so the two-char token wins over nested /-then-* parsing.
  boldItalic = "/*" ~spaceOrEnd biInner+ "*/" attrs?
  // `nl` belongs here: a paragraph folds across lines, so a combined
  // /*...*/ span may too. Without it the production failed on any
  // multi-line span and the delimiter stack paired the two characters
  // separately, giving em-outside-strong where the single-line form and
  // all three engines give strong-outside-em (grammar.ebnf bold_italic).
  biInner    = ~("*/") (rich | word | " " ~("*/") | nl | litDelim | other)

  // constructs allowed inside any span (everything except spans themselves,
  // which are listed per-delimiter to exclude self-nesting)
  rich       = arrow | symbol | delimRun | inlineNote | footnoteRef | crossref | extension | symbolAttr | shortcode | mention | tag
             | editorial | forcedSpan | mathD | mathI
             | codeA | escape | imageRef | image | bracketed | autolink | bang | dollar
             | ellipsis | dashRun | dquote | squote
             | dot | dash | plus | pct

  // The bare single-char span productions (emph/strong/underline/strike/
  // highlight with per-delimiter bare_opener/bare_closer word-boundary guards,
  // interior-space and litSelf helpers) previously lived here. They resolved
  // runs by PEG backtracking -- O(n^2) on a long run of unclosed openers. They
  // are now REPLACED by the O(n) delimiter-stack pass in scripts/spec/render.mjs
  // (grammar.ebnf PART 9 $9). A bare `/ * _ ~ =` reaches the resolver as a
  // `litDelim` candidate token; `^` and `,` have no bare span and stay literal.

  // Verbatim code span: equal-length maximal backtick runs (Core uses the
  // 1..3 tier; longer runs are out of Core). Single-space strip is applied
  // by the renderer per the code_span rule.
  codeA      = rawInline | codeAttrd
  codeAttrd  = code attrs?
  code       = code3 | code2 | code1 | codeU
  // UNCLOSED RUN (PART 3 code_span): an opener with no equal-run closer
  // ahead opens a verbatim span to the END OF BLOCK; opaque; no
  // single-space strip
  codeU      = "\u0060" "\u0060"* any*
  code1      = "`" (~"`" any)+ "`" ~"`"
  code2      = "``" (~"``" any)+ "``" ~"`"
  code3      = "```" (~"```" any)+ "```" ~"`"

  escape     = "\\" punctChar
  // escaped SPACE is a non-breaking space; a backslash at END OF LINE is a
  // hard break (PART 3)
  nbspEsc    = "\\" " "
  hardBreak  = "\\" &(newline | end)

  // --- Mentions and tags (PART 9 SS7): name = letters/digits/_/- with
  // INTERIOR dots; a trailing dot is punctuation. Word boundary on the
  // left is enforced by the word rule's atGlue/hashGlue absorption.
  // The glued TAIL is the right half of the same boundary rule. A second
  // marker written directly against a name (`#i#j`, `@a@b`) is preceded by a
  // word character - the last character of the first name - so it cannot open
  // a second mention or tag. `word`'s atGlue/hashGlue absorption cannot see
  // that case, because the run starts with the marker and never enters `word`
  // at all, so the tail is absorbed here and rendered as literal text
  // (carve#1156).
  mention    = "@" tagName gluedMarker*
  tag        = "#" tagName gluedMarker*
  gluedMarker = ("@" | "#") tagName
  tagName    = tagChar+ (tagDot tagChar+)*
  tagChar    = letter | digit | "_" | "-"
  tagDot     = "." &tagChar

  // --- Math (PART 3: `$` / `$$` + a verbatim span; bare `$` is literal) ---
  mathI      = "$" code attrs?
  mathD      = "$$" code attrs?

  // --- Inline literal (PART 9 SS27): "!" prefix on a verbatim code span,
  // mirroring math's "$" prefix. Content is HTML-escaped and emitted by every
  // renderer; the <code> wrapper is dropped. A trailing attribute block is the
  // ORDINARY code-span attribute block -- with attributes a <span> carries
  // them, with none bare escaped text is emitted. Tried before `image` and
  // `bang` in the inline alternation so `!` binds to a following backtick run.
  litInline  = "!" code attrs?

  // --- Cross-reference with auto text (PART 3 auto_text_link) -------------
  crossref   = "</#" xrefId ">"
  xrefId     = (~">" ~space ~newline any)+

  // --- Footnotes (PART 3; a bare `^` is literal, so `^[` is unambiguous) --
  footnoteRef = "[^" fnLabel "]" attrs?
  // A physical-line identifier: spaces and tabs are data, newlines are not.
  // This mirrors the one-line definition marker and grammar.ebnf §16.
  fnLabel    = (~"]" ~newline any)+
  // An EMPTY or WHITESPACE-ONLY note is literal (grammar.ebnf §16: "Empty or
  // whitespace-only (`^[]`, `^[ ]`) is literal"), so `^[` does not open one -
  // the `^` falls through to text and the `[...]` is an ordinary bracketed run,
  // which is why `^[]{.c}` renders `^<span class="c"></span>` rather than a
  // note. Stated here rather than in the semantics: the rendering of the
  // literal fallback is the bracketed rule's, not this one's.
  inlineNote = "^[" ~((" " | "\t")* "]") brContent* "]" attrs?

  // --- Forced intraword spans {X...X} (PART 9 SS22) and editorial markup.
  // A same-type delimiter inside a forced span is literal until the `X}`
  // closer; other constructs nest normally.
  forcedSpan = forced<"/"> | forced<"*"> | forced<"_"> | forced<"~">
             | forced<"^"> | forced<","> | forced<"=">
  forced<d>  = "{" d fInner<d>* d "}" attrs?
  // `looseAttrs` is admitted so a nested bare span's trailing `{...}` attribute
  // block is consumed here (the removed bare-span rules used to grab it via
  // their `attrs?`); the SS9 stack over these tokens then re-attaches it.
  fInner<d>  = ~(d "}") (rich | span | word | spComment | inlineSpace | litDelim
             | looseAttrs | bang | dollar | ellipsis | dashRun | dot | dash | plus | pct
             | lt | gt | dquote | squote | hash | other)

  // editorial: {+ins+} {-del-} {~old~>new~} {# comment #} (+ the doubled
  // {++...++} / {--...--} forms whose extra marker chars stay literal)
  editorial  = edSub | edIns | edDel | edComment
  edIns      = "{+" (~"+}" edChar)* "+}" attrs?
  edDel      = "{-" (~"-}" edChar)* "-}" attrs?
  edSub      = "{~" (~"~>" ~"~}" edChar)* "~>" (~"~}" edChar)* "~}" attrs?
  edComment  = "{#" (~"#}" edChar)* "#}" attrs?
  edChar     = ~newline any

  // raw inline passthrough: a code span whose trailing block is EXACTLY
  // {=format} (PART 9 SS20)
  rawInline  = code "{=" ident "}"

  // --- Inline extensions: :name[content] -> ext span (PART 8 rank 9);
  // content ends at the FIRST unescaped "]" (corpus 16-5)
  extension  = ":" extName "[" extContent "]" attrs?
  extName    = identStart identRest*
  extContent = (escape | (~"]" ~newline any))*

  // An attributed symbol shortcode `:name:{...}` wraps in a <span> carrying
  // the attribute block. Core has no symbol map, so an UNMAPPED symbol resolves
  // to its literal text `:name:` as the span body (the same fallback as the
  // bare `shortcode` form). The attribute block is CONSUMED here so it attaches
  // to this span rather than the surrounding text. A bare `:name:` with no
  // attribute block stays literal text (see `shortcode`).
  symbolAttr = ":" shortcodeName ":" attrs
  // An UNattributed `:name:` shortcode. Core has no symbol map, so it renders
  // literally -- but it must still be CONSUMED as one token, or its inner
  // characters would fall through to smart typography (`:+-:` would become
  // `:±:` instead of the symbol `+-`). PART 9 §7: a symbol is recognized
  // before the typographic replacements.
  shortcode  = ":" shortcodeName ":" ~attrs

  // --- Bracketed constructs: link / image / span / reference link ---------
  // The single-char lookahead after `]` selects the construct (PART 9 S14);
  // a bare bracketed run with no tail is LITERAL text (rendered with its
  // content inline-parsed).
  bracketed  = "[" brContent* "]" brTail?
  brContent  = escape | code | nested | (~"]" ~newline any)
  nested     = "[" brContent* "]"
  brTail     = linkTail | refTail | attrs | emptyAttrs
  linkTail   = "(" dest destTitle? ")" attrs?
  refTail    = "[" refLabel? "]" attrs?
  refLabel   = (~"]" ~newline any)+
  // A destination's parentheses BALANCE (grammar link_destination), so a URL
  // carrying one is written plainly; the run ends at the first `)` with no
  // opener left to pair with. An escaped parenthesis, and an escaped
  // backslash, are the only escapes, and neither opens nor closes a level.
  dest       = destChar*
  destChar   = destEsc | destParens | (~("(" | ")" | " " | "\t" | newline) any)
  destEsc    = "\\" ("(" | ")" | "\\")
  destParens = "(" destChar* ")"
  // NO TAB. `link_title` is spelled `space` in grammar.ebnf. The slot is
  // PADDING rather than a marker separator - a link is already a link once its
  // destination has been read, so the title is trailing metadata - but padding
  // takes `space` too, because the slot sits after the first non-whitespace
  // character of the line and a tab is syntax only in a leading indentation
  // run (PART 7, MARKER SEPARATORS AND PADDING SLOTS; carve#901 correcting
  // carve#878). This file briefly read `" " | "\t"` to match the widened
  // production (carve#888); the production has since narrowed back, and the
  // two files in `resources/` agree again. `destChar` already
  // excludes both space and tab, so the destination still ends at either.
  //
  // The three engines accept a tab here and now diverge from the production;
  // that is reported upstream rather than encoded here. No corpus document
  // carries a tab in this slot, so narrowing it moves no golden (measured:
  // core:check stays 675/675).
  //
  // CARDINALITY IS EXACTLY ONE SINCE carve#912. This was `titleSp+`, a run,
  // and it carried a note saying the run had always been the looser of the two
  // spellings and that which side gives was a question for the production.
  // The production answered: `link_title = space, ...` is right and the four
  // artifacts that accepted a run - carve-js, carve-php, carve-rs and the
  // oracle - are lax. So `[t](/u<SP><SP>"T")` is no longer a titled link, and
  // the same holds at `image_title = link_title` and at the definition
  // spelling in scripts/spec/layout.mjs, which narrowed in the same change.
  //
  // The cost was recorded rather than discovered: every document with two
  // spaces before a title reparses. This is deliberately the opposite call
  // from the one carve#905 made for the terminal, which changed WHICH
  // character a slot admits and left HOW MANY alone.
  destTitle  = titleSp (quoted | squoted)
  titleSp    = " "
  squoted    = "'" sqChar* "'"
  sqChar     = sqEsc | (~"'" ~newline any)
  sqEsc      = "\\" "'"
  quoted     = "\"" qChar* "\""
  qChar      = qEsc | (~"\"" ~newline any)
  qEsc       = "\\" "\""

  image      = "!" "[" altText "]" "(" dest destTitle? ")" attrs?
  // `![alt][ref]` resolves against the SAME linkDefs entry a reference link
  // does, taking url, title and attrs from it (PART 9R R1). Without this rule
  // the `!` fell through to `bang` and the rest matched `bracketed`, so an
  // image reference rendered as a literal "!" followed by an <a> (carve#604
  // follow-up). Tried BEFORE `image` in the inline alternation so the
  // bracket form wins over the paren form for the same prefix.
  imageRef   = "!" "[" altText "]" "[" refLabel? "]" attrs?
  altText    = (~"]" ~newline any)*

  // --- Autolinks (PART 3): URL or email in angle brackets ------------------
  autolink   = "<" (urlBody | emailBody) ">" attrs?
  urlBody    = scheme ":" urlChar+
  // ASCII, per `scheme = letter, {letter | digit | '+' | '-' | '.'}` in
  // grammar.ebnf, where `letter` is the enumerated ASCII alphabet. ohm's
  // built-in `letter` is Unicode-aware, so this rule used to accept
  // a scheme written in Han characters - an autolink no engine produces and
  // the production never described. Only the BODY admits non-ASCII (carve#844).
  scheme     = asciiLetter (asciiLetter | digit | "+" | "-" | ".")*
  asciiLetter = "a".."z" | "A".."Z"
  emailBody  = emailLocal "@" (emailSeg ".")+ letter+
  emailLocal = emailChar+
  emailSeg   = (letter | digit | "-" | "_")+
  emailChar  = letter | digit | "-" | "_" | "." | "+"
  // The ASCII enumeration of `url_char`, plus every character outside ASCII
  // that is neither whitespace nor a FORMAT character (carve#844). The ASCII
  // exclusions are unchanged and deliberate - `"`, `\`, backtick, `{`, `}`,
  // `|`, `^`, `<`, `>` still break the construct.
  urlChar    = asciiLetter | digit | "-" | "." | "_" | "~" | ":" | "/" | "?"
             | "#" | "[" | "]" | "@" | "!" | "$" | "&" | "'" | "(" | ")"
             | "*" | "+" | "," | ";" | "=" | "%" | uUrlChar
  uUrlChar   = ~ascii ~uControl ~uSpace ~uFormat any
  ascii      = "\u0000".."\u007F"
  // The C1 controls. `~ascii` already rejects every C0 control, so this
  // range is the whole of "not a control character" that is left to state -
  // and it is not covered by `uSpace` (only U+0085 is whitespace) or by
  // `uFormat` (none of them is Cf).
  uControl   = "\u0080".."\u009F"
  // The Unicode White_Space property outside ASCII; inside ASCII the `ascii`
  // guard above has already rejected. Spelled as escapes rather than as the
  // characters themselves: this file is reviewed as text, and a rule whose
  // terminals are invisible is one editor save from silently admitting them.
  uSpace     = "\u0085" | "\u00A0" | "\u1680" | "\u2000".."\u200A"
             | "\u2028".."\u2029" | "\u202F" | "\u205F" | "\u3000"
  // General_Category=Cf. An astral format character is matched at its HIGH
  // surrogate, which is where the guard has to reject it: `any` consumes one
  // UTF-16 code unit, so a lookahead spelled only over the BMP would let the
  // pair through half at a time.
  // Split in two because ohm requires the alternatives of one rule to have
  // uniform arity, and a surrogate pair is two terminals where a BMP character
  // is one.
  uFormat    = uFormatBmp | uFormatAstral
  uFormatBmp = "\u00AD" | "\u0600".."\u0605" | "\u061C" | "\u06DD" | "\u070F"
             | "\u0890".."\u0891" | "\u08E2" | "\u180E"
             | "\u200B".."\u200F" | "\u202A".."\u202E"
             | "\u2060".."\u2064" | "\u2066".."\u206F"
             | "\uFEFF" | "\uFFF9".."\uFFFB"
  uFormatAstral = "\uD804" ("\uDCBD" | "\uDCCD")
             | "\uD80D" ("\uDC30".."\uDC3F")
             | "\uD82F" ("\uDCA0".."\uDCA3")
             | "\uD834" ("\uDD73".."\uDD7A")
             | "\uDB40" ("\uDC01" | "\uDC20".."\uDC7F")

  // --- Attribute block (PART 4, strict identifiers) ------------------------
  attrs      = "{" attrSp* attrItem (attrSp+ attrItem)* attrSp* "}"
  // SPACE ONLY, the A7 position of PART 4's THE INLINE INTERIOR IS SPACE-ONLY.
  // This ran on `(" " | "\t")*` until carve#906, and it is a SECOND site rather
  // than a use of `attrSp`: narrowing `attrSp` alone leaves `[x]{<TAB>}` a valid
  // empty block, so the two have to move together or corpus 252-3 survives the
  // change it is supposed to pin.
  emptyAttrs = "{" " "* "}"
  // NO TAB. `attributes` pads with `attr_pad = {space}` in grammar.ebnf and
  // `attribute_list` separates with `space+` (carve#906). Every one of those
  // slots sits after the first non-whitespace character of its line, where a
  // tab is not syntax - PART 7's rule covers them with no exception to write.
  // This rule said `" " | "\t"` for one day, under the reading carve#901 then
  // corrected; before that it said `" " | "\n"`, which was wrong the other way.
  // The block-attribute LINE below deliberately keeps the tab AND the newline.
  // NO NEWLINE EITHER, for a different reason. The line-spanning form is a
  // different production: `block_attributes` uses
  // `attr_separator = (whitespace | continuation), opt_ws`, and `continuation`
  // is where a newline is admitted. This file owns the INLINE layer, so a
  // newline here made `*x*{.a\n.b}` an attribute block in the oracle alone -
  // all three engines leave it literal text (carve#878).
  attrSp     = " "
  // The LINE-SPANNING form, `block_attributes` in grammar.ebnf: its separator
  // is `attr_separator = (whitespace | continuation), opt_ws`, and
  // `continuation` is a single line break. Only a standalone attribute LINE
  // takes this; an inline block uses `attrs` above and stops at the newline.
  // AT MOST ONE LINE BREAK PER SLOT, mirroring the three productions this
  // rule implements: `opt_pad = opt_ws, [continuation]`,
  // `attr_separator = (whitespace | continuation), opt_ws` and
  // `continuation = newline, opt_ws`. It ran on `battrSp*` with the newline
  // folded into `battrSp`, so `{.a` + blank line + `.b}` matched here while
  // grammar.ebnf says a BLANK line ends a block attribute and is never
  // interior padding (carve#888).
  //
  // That was LATENT rather than wrong output: scripts/spec/layout.mjs bails
  // on a blank line before this rule is reached, so no document could show
  // it. A contradiction between this file and the production it implements is
  // worth removing anyway - a reader who hits one has to know which is the
  // language, and at the time nothing said (it does now: the production). tests/block-attribute-line-breaks.test.mjs drives this
  // rule directly so the narrowing is observable rather than another
  // unevaluated edit (carve#755, carve#916).
  blockAttrs = "{" battrPad attrItem (battrSep attrItem)* battrPad "}"
  battrPad   = battrSp* battrCont?
  battrSep   = (battrSp | battrCont) battrSp*
  battrCont  = "\n" battrSp*
  battrSp    = " " | "\t"
  attrItem   = langAttr | idAttr | classAttr | kvAttr | boolAttr
  idAttr     = "#" ident
  classAttr  = "." ident
  kvAttr     = ident "=" attrVal
  boolAttr   = ident
  // `{:TAG}` is EXACT SUGAR for `lang=TAG`, and `{:}` for `lang=""`
  // (`language_attribute` in grammar.ebnf). The desugaring happens in the
  // `parseAttrs` action, not here, so every downstream rule - merge order,
  // last-wins, hardening, the HTML serializer - reaches it as an ordinary
  // key/value and needs no case of its own. That is the claim the shorthand
  // makes, and routing it through one action is what makes the claim testable
  // rather than restated.
  //
  // ASCII ONLY. Ohm's `alnum` follows Unicode, so it accepts `ç` and `é` and
  // would have made `{:français}` a language attribute reading `français` -
  // one of the shapes grammar.ebnf names as staying literal. `asciiLetter`
  // and `digit` are both ASCII-bounded, which is what `language_subtag`
  // means by "ASCII alphanumeric".
  //
  // EIGHT OPTIONAL CHARACTERS rather than `alnum+`, because BCP 47 caps a
  // subtag at eight and Ohm has no counted repetition. A ninth character then
  // has no rule to match, `attrs` fails at the `}`, and the whole block stays
  // literal source - which is what PART 9 §14 already promises for a malformed
  // attribute block. Writing `alnum+` here would have moved the cap into a
  // semantic action, where a violation cannot fail the match and would have to
  // be smuggled out as a wrong answer.
  langAttr   = ":" langTag?
  langTag    = langSubtag ("-" langSubtag)*
  // `langSubChar`, not `langChar`: that name is taken by the code-fence
  // language token above, which is a different alphabet on purpose (it admits
  // `+`, `#`, `.` and `/` for `c++`, `f#` and `objective-c`).
  langSubtag = langSubChar langSubChar? langSubChar? langSubChar? langSubChar?
               langSubChar? langSubChar? langSubChar?
  langSubChar = asciiLetter | digit
  attrVal    = quoted | squoted | bareVal
  // NO TAB EITHER. `unquoted_value` in grammar.ebnf is letters, digits, `-`,
  // `_`, `.` and `:` - a tab is not among them - so a tab after a bare value
  // is the separator before the next attribute. Admitting it here swallowed
  // the separator into the value: `{k=a<TAB>.b}` came out as one attribute
  // `k="a\t.b"` where all three engines give `k="a" class="b"` (carve#878).
  bareVal    = (~(" " | "\t" | "}" | newline) any)+
  ident      = identStart identRest*
  // No leading `-`: PART 7 (normative) is
  //   identifier = (letter | '_'), {letter | digit | '_' | '-'} ;
  // and all three engines follow it - `{--flag}` and `{#-id}` are literal
  // text everywhere but here (carve#722). A dash is still fine after the
  // first character, which is what `identRest` is for.
  identStart = letter | "_"
  identRest  = letter | digit | "_" | "-"

  // A word absorbs any bare delimiter glued between two word characters -
  // this IS the left word-boundary / no-intraword rule, structurally.
  word       = wordChar (wordChar | wordGlue | atGlue | hashGlue | colonGlue | dotGlue | pctGlue)*
  wordGlue   = delim &wordChar
  // absorb the `@`/`#`/`:` glued between word chars (me@example.com, a#b,
  // a:b:c, 10:30) and the intraword dot so none triggers mention / tag /
  // symbol / typography rules (the left word-boundary guard: a symbol only
  // opens at start or after a non-word char, matching @mention / #tag)
  atGlue     = "@" &wordChar
  hashGlue   = "#" &wordChar
  // absorb an intraword colon, but NOT one that opens an inline extension
  // (`a:kbd[x]`): extensions have no left-boundary restriction, so the
  // `:name[` opener must still reach the extension rule.
  colonGlue  = ":" ~(extName "[") &(wordChar | "+" | "-")
  dotGlue    = "." &wordChar
  // a %-run glued to a word is literal (50%%, a%%b) - never a comment
  pctGlue    = "%" "%"* &(wordChar | " " | end)
  // NOTE: a `_` glued to a word (e.g. `a_/b`) is NOT absorbed here -- it reaches
  // the resolver as a bare `litDelim` candidate. The bare_opener guard already
  // keeps a delimiter that FOLLOWS a `_` from opening (grammar.ebnf §9,
  // `prev === '_'` in bareOpener), and the `_` itself must stay a candidate so
  // it can CLOSE an open underline span (`_z_/y/` -> <u>z</u>/y/, matching the
  // engines + §9 close-first). A former `underGlue = "_" delim &wordChar` rule
  // swallowed that closing `_` into a text run and diverged.
  wordChar   = letter | digit
  delim      = "/" | "*" | "_" | "~" | "^" | "=" | ","

  // a whitespace-preceded %% consumes the rest of the LINE (SS21); the
  // space itself is consumed too
  spComment  = " " "%%" (~newline any)*
  inlineSpace = " "

  // A bare delimiter that opened nothing is literal text.
  litDelim   = delim
  bang       = "!" ~"["
  dollar     = "$" ~"`" ~"$"
  // single punctuation is plain text; RUNS that smart-typography or the
  // comment syntax would transform (`...`, `--`, `+-`, `%%`) are Full
  // Carve, so Core refuses them
  // a `<` that opens no autolink/crossref, and a bare `>`, are literal
  // text (HTML-escaped by the renderer)
  lt         = "<"
  gt         = ">"
  // SMART TYPOGRAPHY (PART 9 SS8). Multi-char patterns are consumed as
  // tokens; the open/close decision for quotes uses the previous source
  // character in the SEMANTICS (deterministic single-char lookbehind).
  arrow      = "<->" | "->" | "<-" | "=>" | "!=" | "<=" | ">=" | "+-"
  symbol     = "(c)" | "(r)" | "(tm)"
  ellipsis   = "..."
  dashRun    = "-" "-"+
  dquote     = "\""
  squote     = "'"
  // a bare `#` (not a tag opener: followed by space/colon/dot/end) is
  // literal - needed for caption number placeholders and prose
  hash       = "#" &(" " | ":" | "." | newline | end)
  dot        = "." ~".."
  dash       = "-" ~"-"
  plus       = "+" ~"-"
  pct        = "%" ~"%"

  // Core-safe plain characters. Everything NOT listed here and not handled
  // above (brackets, braces, quotes, $, <, >, !, %, dashes, dots, ...)
  // makes the line - and the document - fail to match: those constructs
  // exist in Full Carve, so Core refuses rather than mis-renders.
  other      = letter | digit | colon | ";" | "?" | "&" | "(" | ")" | at
  // catch-all: any remaining character is literal text (HTML-escaped; the
  // Trojan-Source bidi strip happens in escapeHtml). Constructs are all
  // tried first, so this only sees genuinely plain characters.
  anyChar    = ~newline any
  // paragraphs are inline-parsed as ONE text with embedded soft breaks
  nl         = "\n"
  // a valid-shaped attribute block with no abutting carrier is LITERAL
  // text (PART 9 SS14/SS15); an invalid payload still refuses
  looseAttrs = attrs
  // a `:` opening an inline extension (:name[...]) is Full Carve -> refuse;
  // a plain colon is text. A bare `:name:` symbol shortcode with no map is
  // literal text in Core, matching Full Carve's mapless fallback; the
  // attributed form `:name:{...}` is refused (see symbolAttr).
  colon      = ":" ~(ident "[")
  shortcodeName = (alnumCh | "+" | "-") (alnumCh | "_" | "+" | "-")*
  // a bare `@` followed by a word char is a mention (Full Carve) -> refuse;
  // an email-embedded `@` is absorbed by the word rule (atGlue)
  at         = "@" ~wordChar

  // --- Lexical ---------------------------------------------------------------
  punctChar  = "!" | "\"" | "#" | "$" | "%" | "&" | "'" | "(" | ")" | "*"
             | "+" | "," | "-" | "." | "/" | ":" | ";" | "<" | "=" | ">"
             | "?" | "@" | "[" | "\\" | "]" | "^" | "_" | "`" | "{" | "|"
             | "}" | "~"
  alnumCh    = letter | digit
  spaceChar  = " " | "\t"
  newline    = "\n" | "\r\n"
  lineEnd    = newline | end
  spaceOrEnd = " " | "\t" | newline | end
}
