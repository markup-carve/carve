{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://markup-carve.github.io/carve/migration-report-schema.json",
  "title": "Carve migration fidelity report",
  "type": "object",
  "required": ["schemaVersion", "sourceFormat", "diagnostics"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "const": 2 },
    "sourceFormat": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Format at the boundary where fidelity assessment begins. An empty diagnostics array asserts complete construct-level assessment."
    },
    "mode": { "type": "string" },
    "adapter": { "type": "string" },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message", "severity", "fidelity", "confidence"],
        "additionalProperties": true,
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "message": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["info", "warning", "error"] },
          "fidelity": { "enum": ["preserved", "normalized", "degraded", "dropped"] },
          "confidence": { "enum": ["exact", "inferred", "fallback"] },
          "path": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "oneOf": [{ "type": "string" }, { "type": "integer" }] } }
            ]
          },
          "line": { "type": "integer", "minimum": 1 },
          "column": { "type": "integer", "minimum": 1 },
          "direction": { "type": "string" },
          "details": { "type": "object" },
          "sourceLocation": {}
        },
        "allOf": [
          {
            "if": { "properties": { "code": { "enum": ["fidelity-unverified", "diagnostics-truncated"] } }, "required": ["code"] },
            "then": { "properties": { "fidelity": { "const": "dropped" }, "confidence": { "const": "fallback" } } }
          }
        ,
          {
            "$comment": "CARVE-P11-063: a damaged carrier-comment set imports as plain Markdown, never a guess.",
            "if": { "properties": { "code": { "const": "carrier-markers-damaged" } }, "required": ["code"] },
            "then": { "properties": { "fidelity": { "const": "degraded" }, "confidence": { "const": "fallback" } } }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "sourceFormat": {
            "const": "markdown"
          }
        },
        "required": [
          "sourceFormat"
        ]
      },
      "then": {
        "properties": {
          "diagnostics": {
            "items": {
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "code": {
                        "enum": [
                          "markdown-atx-heading",
                          "markdown-autolink",
                          "markdown-block-quote",
                          "markdown-bullet-list",
                          "markdown-bullet-task",
                          "markdown-code-span",
                          "markdown-emphasis",
                          "markdown-entity",
                          "markdown-escape",
                          "markdown-fenced-code",
                          "markdown-hard-break",
                          "markdown-image",
                          "markdown-indented-code",
                          "markdown-link",
                          "markdown-list-item",
                          "markdown-ordered-list",
                          "markdown-paragraph",
                          "markdown-reference-definition",
                          "markdown-reference-link",
                          "markdown-setext-heading",
                          "markdown-soft-break",
                          "markdown-strikethrough",
                          "markdown-strong",
                          "markdown-table",
                          "markdown-table-cell",
                          "markdown-table-row",
                          "markdown-thematic-break",
                          "raw-preserved"
                        ]
                      }
                    },
                    "required": [
                      "code"
                    ]
                  },
                  "then": {
                    "required": [
                      "path"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "pattern": "^line:[1-9][0-9]*$"
                      }
                    }
                  }
                }
              ],
              "type": "object"
            },
            "type": "array"
          }
        }
      }
    }
  ]
}
