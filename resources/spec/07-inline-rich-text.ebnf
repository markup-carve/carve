(* --- Math (djot form; PART 9 §18) --- *)
(* Inline `$` + a verbatim (backtick) span; display `$$` + a verbatim
   span. The backtick span removes ambiguity with a literal `$`, so
   currency such as `$5` (no following backtick run) stays literal text.
   Both forms are inline; display math renders inside its own paragraph
   when alone on a line. There is NO bare `$…$` form and NO `\(…\)` input
   form -- those were dropped (`\(` is just an escaped paren). *)
math = math_inline | math_display ;
math_inline = '$', code_span ;
math_display = "$$", code_span ;
(* TRAILING ATTRIBUTES on math -- NORMATIVE [CARVE-P3-012]: math reuses `code_span`, which
   carries the generic `[attribute_run]` slot, so `$\`x\`{.c}` / `$$\`x\`{.c}`
   parse a trailing attribute block and APPLY it to the math span, merging
   classes into the existing `math inline` / `math display` class
   (`<span class="math inline c">`); `#id` / `key=value` are applied too.
   The `{=format}` raw form is code-span-ONLY and is NOT inherited by math or
   an inline literal: `$\`x\`{=html}` and `!\`x\`{=html}` leave the `{=html}`
   literal.
   The math content is the verbatim text of the reused code_span. *)

(* --- Emphasis. PART 9 §9 (CARVE-P9-043) is the one inline pairing
   procedure: these productions name the spans it forms, and §9 decides which
   characters pair. Every bare delimiter is one character, `/ * _ ~ =`, and
   none opens or closes intraword: `foo*bar*baz`, `snake_case`, `a/b/c` and
   `x = 5` stay literal. This is STRICTER than Djot, whose rule is
   whitespace-only. `^` and `,` are not bare delimiters: superscript and
   subscript exist only in the braced form (`H{,2,}O`, `mc{^2^}`), because
   they attach to characters rather than words and because a stray `,` in
   prose must not open a span. The braced family `{X … X}` is the intraword
   form (PART 9 §22). --- *)

(* FORMAL word-boundary guards -- NORMATIVE [CARVE-P3-013]; production templates (GUARD
   NOTATION, header) instantiated for every bare delimiter
   d in { '/', '*', '_', '~', '=' } (all single-char): *)

bare_opener(d) = <!(alnum | '_' | d | slash_if(d)), d, !(ws | d | grapheme_extender | gt_if(d)) ;
bare_closer(d) = <&(non_ws), d, !(alnum | grapheme_extender) ;
(* A DELIMITER IS A WHOLE GRAPHEME -- NORMATIVE [CARVE-P3-025]. A delimiter
   character counts only when it is a whole grapheme. A d followed by a
   grapheme_extender is the first code point of a larger character, so it is
   text: it neither opens nor closes (the `grapheme_extender` terms of both
   templates). The keycap emoji U+002A U+FE0F U+20E3 is one character to the
   reader, and its `*` opens or closes nothing, before a word or after one.
   The character is skipped, not a barrier: a later delimiter still pairs
   across it. The same guard sits on the delimiter of every braced opener:
   the seven forced openers, `{^` and `{,` included, the editorial openers
   `{+`, `{-`, `{~` (substitution) and `{#`, and the braced comment `{%`
   (each production below and `braced_comment` carry it). It also sits on
   the `*` of the combined `/*` token below. A closer `X}` or `*/` is
   followed by its own brace or slash, so the guard cannot apply there.
   An include `{{` needs a space next, so no extender can follow it. Only the character AFTER d is read: what precedes d is
   judged as before. A spacing mark (Mc, such as U+093E) extends a grapheme
   like a nonspacing one: Unicode's extended grapheme clusters include both. *)
grapheme_extender = (* a character of Unicode general category Mn, Mc or Me *)
                  | (* U+FE00 .. U+FE0F, VARIATION SELECTOR-1 to -16 *)
                  | (* U+200D ZERO WIDTH JOINER *) ;
(* The look-behind reads the source character before d. Which `_` or `/`
   before an opener is markup rather than a guard is PART 9 §9 GUARD
   EXEMPTION. *)

(* gt_if(d) = '>' when d = '=', otherwise nothing: `=>` is never a highlight
   opener (CARVE-P3-022), so `=>y=` is text. *)
(* slash_if(d) = '/' when d in { '/', '_' }, otherwise nothing: italic and
   underline additionally never open when the char immediately before d is `/`
   (path protection, PART 9 §9: /a/_b_, snake_/case/, a_/_a_). For d = '/'
   this coincides with same-delimiter adjacency; for d = '_' it is the extra
   cross-delimiter guard. The other delimiters '*', '~', '=' are NOT guarded
   against a preceding '/', so a/~y~ -> a/<s>y</s>. *)

emphasis = bare_opener('/'), emphasis_content, bare_closer('/'), [attribute_run] ;  (* italic *)
strong = bare_opener('*'), strong_content, bare_closer('*'), [attribute_run] ;       (* bold *)
bold_italic = bare_opener('/'), '*', !(grapheme_extender), bi_content, '*', bare_closer('/'), [attribute_run] ;
   (* the combined `/*` opener: the boundary guards apply to the OUTER `/`;
      the inner `*` is part of the two-char token and carries only the
      CARVE-P3-025 guard *)
underline = bare_opener('_'), underline_content, bare_closer('_'), [attribute_run] ;
strikethrough = bare_opener('~'), strike_content, bare_closer('~'), [attribute_run] ;
highlight = bare_opener('='), highlight_content, bare_closer('='), [attribute_run] ;  (* single-char; was "==" *)
(* there is NO bare superscript/subscript production -- `^` and `,` delimit
   nothing outside the forced forms; see the rationale note above and
   forced_super / forced_sub below *)

(* --- Braced intraword emphasis (PART 9 §22). A brace pair around a mark
   forms a span with no word-boundary condition; how it finds its closer is
   PART 9 §9 R1. Every mark has a braced form: *)
forced_emphasis   = "{/", !(grapheme_extender), forced_content, "/}", [attribute_run] ;   (* italic    *)
forced_strong     = "{*", !(grapheme_extender), forced_content, "*}", [attribute_run] ;   (* bold      *)
forced_underline  = "{_", !(grapheme_extender), forced_content, "_}", [attribute_run] ;   (* underline *)
forced_super      = "{^", !(grapheme_extender), forced_content, "^}", [attribute_run] ;   (* sup       *)
forced_sub        = "{,", !(grapheme_extender), forced_content, ",}", [attribute_run] ;   (* sub       *)
(* `{~ … ~}` is braced strikethrough UNLESS it holds a `~>` at its own
   level, in which case it is editorial substitution (PART 9 §9). *)
forced_strike     = "{~", !(grapheme_extender), forced_content, "~}", [attribute_run] ;
(* `{= … =}` is forced highlight (see Editorial Markup below for the
   distinction from the raw-inline `{=format}` attribute). *)
forced_highlight  = "{=", !(grapheme_extender), forced_content, "=}", [attribute_run] ;
(* ONE RULE, SEVEN NAMES. Every emphasis-family span holds the same content, so
   it is spelled once here and each slot below is a named alias of it. The names
   stay because a call site reads better naming its own slot; widening what a
   span may hold is one edit, here. *)
inline_span_content = (inline_element | text_run | literal_special)+ ;
forced_content    = inline_span_content ;
(* AN EMPTY BRACE PAIR IS NOT A CONSTRUCT -- NORMATIVE [CARVE-P3-014]. The `+`
   above is load-bearing: an opener that meets its own closer with nothing
   between them opened nothing.

     {//}  {**}  {__}  {~~}  {^^}  {,,}  {==}  {++}  {##}

   form no span. Their characters are read like any others (carve#3973 X6):
   the braces are text, and a bare delimiter among them is a §9 candidate,
   so `{**}` alone is literal while `*a {*}` closes the strong span at the
   `*`. IT APPLIES TO THE EDITORIAL FAMILY TOO, whose content
   slots are the same `+` repetition (braced en dash: CARVE-P3-020).

   THE ONE EXCEPTION is a fully empty SUBSTITUTION, `{~~>~}`, which renders an
   empty del followed by an empty ins (CARVE-P3-016). *)

(* TRAILING ATTRIBUTES -- each emphasis-family span MAY carry a trailing
   `[attribute_run]`: the generic inline-attribute carrier that attaches
   to the immediately-preceding inline node (the general rule, examples.md
   "Trailing attribute block edge cases"). `*x*{.real}` ->
   `<strong class="real">x</strong>`. It is the SAME `[attribute_run]` slot
   every other inline carrier uses (code_span, link, image, inline_span,
   extension_inline, autolink). Pinned by corpus
   80-trailing-attribute-block-edge-cases. *)

(* Content MAY contain the delimiter character: a delimiter that does not
   close (PART 9 §9) is literal content, not the span boundary. The span
   ends at the matched closer only. The boundary is a semantic constraint
   (PART 9 §9), not a context-free one. *)
emphasis_content = inline_span_content ;
strong_content = inline_span_content ;
bi_content = inline_span_content ;
underline_content = inline_span_content ;
strike_content = inline_span_content ;
highlight_content = inline_span_content ;

(* --- Footnotes (PART 9 §16) --- *)
(* Both implemented forms: the REFERENCE form `[^label]` resolving against a
   `[^label]: body` definition, and the INLINE form `^[content]` (pandoc
   form; a deliberate carve extension over djot). Numbering (one shared
   document-order sequence), endnotes rendering, and the inline form's
   balanced-bracket close are PART 9 §16. A bare `^` opens no superscript,
   so `^[` is unambiguous. These two are the only
   note forms; `[>` opens nothing, so `[>foo]` is literal text. *)
footnote = reference_footnote | inline_footnote ;
reference_footnote = "[^", footnote_label, ']', [attribute_run] ;
(* A label is a physical-line identifier and never holds a source newline: a
   definition marker occupies one line, and admitting a newline only on the
   reference side would create an identifier no valid definition can bind. A
   tab in a label is content. Matching uses PART 9R R2's key, which collapses
   space runs only. *)
footnote_label = {character - ']' - newline}+ ;
inline_footnote = "^[", inline_content, ']', [attribute_run] ;
(* the closing `]` is the balanced, escape- and LITERAL-SPAN-aware close
   (PART 9 §16) -- the same scan `link_text` states, and the same spans
   it skips (CARVE-P3-001); footnote recognition is DISABLED inside the content *)

footnote_definition = "[^", footnote_label, "]:", space+, inline_content, newline,
                      {footnote_continuation | continuation_marker_block
                      | lazy_continuation_line}
                    | "[^", footnote_label, "]:", space+, first_block_content ;
footnote_continuation = (footnote_indent, inline_content, newline) | blank_line ;
footnote_indent = whitespace, {whitespace} ;
(* A footnote definition has the `[^label]: ` marker and renders as an endnote.
   Its body follows PART 9 §24 C3 (CARVE-P9-083), including column arithmetic,
   blank runs, lazy paragraph text, `+` attachment and closing by column.
   `footnote_indent` spells a whitespace run; the shared column rule decides
   whether that run reaches the body's two-column floor.

   `inline_content` above describes THE SHAPE OF A LINE that belongs to the
   body, not how the collected body is parsed. The body is parsed AS BLOCKS
   (PART 9 §16: "parsed as blocks"), so a note may hold a table, a list, a code
   block or a quote, and the indentation beyond the body's own is theirs to
   read.

   THE BODY'S OWN COLUMN IS TWO -- NOT the first continuation line's actual
   indent. An opener past it opens in the body, measured from its own line
   (PART 0 S3, CARVE-P0-024). Two is a floor for the body, not a ceiling for
   its blocks. *)

(* --- Citations (Tier-2 extension) --- *)
(* TIER-2, OFF BY DEFAULT. A `[...]` whose content contains a `@key` and which
   has NO link/ref/span tail (`(url)` / `[ref]` / `{attrs}`) is a citation; a
   bare `@key` stays a mention (PART 9 §7) and `\@` is literal. Items are
   `;`-separated; each is `[prefix] [-] @key [, locator]`. Bibliography entries
   are defined in-document: `[@key]: {author= year=}? entry` -- the `{…}` is
   optional and feeds author-date, and a leading `@` label is RESERVED here,
   never a link definition (see reference_definition). NUMBERED output is the
   DEFAULT: `[1]` plus an ordered references list. AUTHOR-DATE output
   (configuration) emits `(Author Year)` plus an alphabetical list. The
   references list is appended at document end, or injected into a
   `::: references` block.

   Undefined behavior (impls MAY differ, NOT corpus-pinned): same-author-year
   disambiguation letters (e.g. `2020a` / `2020b`) are out of scope for v1 -
   the bare year is emitted.
   Failure-mode handling IS pinned (tests/corpus-optional): a group with any
   undefined key renders the verbatim source; a `[@k]{...}` is a span, not a
   citation; a `[@k, a; b]` with a `;` in the locator is literal text. *)
citation_group = '[', ['+'], citation_item, {';', citation_item}, ']' ;
citation_item = [inline_content], ['-'], '@', citation_key, [',', space, inline_content] ;
(* A single leading `+` immediately after `[` sets the whole citation cluster to
   integral mode (CSL/Citum CitationMode: integral = author-in-text; absent =
   non-integral/parenthetical), the Djot draft `[+@foo, p. 15]` form. Mode is a
   GROUP property; there is no per-item `+`. A bare `+` before `@key` inside a
   multi-item bracket (e.g. `[@a; +@b]`) is parsed as prefix text on that item,
   not as an integral marker. An integral cluster wraps the ENTIRE citation
   group output in `<span class="citation" data-cite-mode="integral">`.
   `-` before `@key` suppresses the author for that item (per-item; applies in
   both numbered and author-date modes via `data-suppress-author="true"`).
   TYPED LOCATOR: the locator (text after the first `,` in an item) is parsed
   into a citeproc label + value + trailing suffix. The label is the LONGEST
   match from the fixed vocabulary below, and matches ONLY at a boundary --
   end of locator, whitespace, an ASCII digit, `§`, or `¶`. Canonical labels,
   with their recognized abbreviations:
     book (bk.) | chapter (chap., chaps.) | column | figure | folio |
     issue (no.) | line (l., ll.) | note (n., nn.) | opus | page (p., pp.) |
     paragraph (para., ¶) | part | section (sec., §) | sub verbo (s.v.) |
     verse (v., vv.) | volume (vol.)
   No label but a leading ASCII digit defaults to `page`; a roman-numeral
   locator with no label produces NO `data-locator-label`. The value is the
   leading run of digits/roman/`.,&-`, with trailing `,`, `&`, `-`, `.` trimmed
   off it; the remainder is the suffix.
   The structure is surfaced as `data-*` attributes on the rendered citation
   anchor, IN THIS ORDER and only where each applies: `data-cite-key`,
   `data-suppress-author`, `data-cite-prefix`, `data-locator-label`,
   `data-locator`, `data-suffix`. Prefix and suffix are flattened plain text. *)
citation_key = (letter | digit | '_'), {citation_key_char} ;
(* Pandoc-compatible key charset: after the first char, any of
   these internal punctuation marks are allowed. *)
citation_key_char = letter | digit | '_' | ':' | '.' | '#' | '$' | '%' | '&'
                  | '+' | '?' | '<' | '>' | '~' | '/' | '-' ;
citation_definition = '[@', citation_key, "]:", space+, [attributes], inline_content, newline ;
(* The line is a NODE in the serialized tree -- `citation_definition`, carrying
   the key, the entry's inline content and the metadata block (PART 12 §18).
   Like the other definition kinds it renders nothing where it sits. *)

(* --- Extensions --- *)
extension_inline = ':', extension_name, '[', extension_content, ']', [attribute_run] ;
extension_name = identifier ;
(* `identifier` already permits a leading `_`, so `_` is a valid extension
   name: `:_[x]` -> `<span class="ext-_">x</span>` (a name outside the
   built-in semantic registry in PART 10 §9 falls back to a generic
   `<span class="ext-NAME">`). It MUST start with a
   letter or `_`, so a digit-first name is NOT an extension: `:1[x]` stays
   literal text, while `:a1[x]` (digit only after the first letter) is valid.
   On a GENERIC extension an authored `{.class}` MERGES into the single
   `class` attribute -- the structural `ext-NAME` class comes FIRST, then the
   authored classes (`:foo[a]{.cls}` -> `class="ext-foo cls"`); never two
   `class` attributes. *)
extension_content = {escaped_char | literal_backslash | (character - ']' - '\')} ;
(* The content runs up to the FIRST UNESCAPED `]`; a nested `]` closes the
   extension early and the remainder is literal: `:foo[a [b] c]` ->
   `<span class="ext-foo">a [b</span> c]`. An escaped one is content:
   `:foo[a\]b]` -> `<span class="ext-foo">a]b</span>`. *)
(* GENERIC EXTENSION CONTENT IS INLINE CONTENT -- NORMATIVE [CARVE-P3-026].
   Parse the captured run as inline content, including nested inline elements;
   do not render its markup as literal characters. Thus `:code[*b*]` renders
   `<span class="ext-code"><strong>b</strong></span>`. An empty captured run
   is permitted and renders an empty generic span: `:code[]` renders
   `<span class="ext-code"></span>`. *)

(* --- Editorial Markup (CriticMarkup-inspired) --- *)
editorial_markup = addition | deletion | substitution | editorial_comment ;

addition = "{+", !(grapheme_extender), inline_content, "+}", [attribute_run] ;
deletion = "{-", !(grapheme_extender), inline_content, "-}", [attribute_run] ;
substitution = "{~", !(grapheme_extender), [inline_content], "~>", [inline_content], "~}" ;
editorial_comment = "{#", !(grapheme_extender), comment_content, "#}" ;
comment_content = (* any text until the matching `#}`, preserved literally;
                     at least one character -- see the empty-brace clause,
                     CARVE-P3-014 *) ;
(* EDITORIAL COMMENT CONTENT IS LITERAL -- NORMATIVE [CARVE-P3-016]. Nothing inside is parsed as markup, spaces
   are preserved, and no escape is resolved: `{# a *b* c #}` holds the eight
   characters ` a *b* c ` and renders them, asterisks included. It is also what
   lets `link_text`'s scan skip the span: with no escape available, a `]`
   inside is uncloseable any other way.

   `addition` and `deletion` are NOT literal: they take `inline_content`, and
   `{+a *b* c+}` really does emphasize `b`.

   AN ADDITION'S AND A DELETION'S CONTENT IS NON-EMPTY -- `inline_content` is a
   `+` repetition, and `comment_content` says it too. `{++}` and `{##}` are
   therefore text, under the same empty-brace clause the forced spans carry.
   `{--}` is no deletion: it is the braced en dash, and it and the nonempty
   deletion spellings follow CARVE-P3-020.

   `substitution` is NOT widened: a half-empty substitution is a real edit --
   `{~a~>~}` deletes and `{~~>b~}` inserts -- so the fully empty form follows CARVE-P3-014. `substitution` takes `inline_content` on both
   sides, so `{~*b*~>*e*~}` emphasizes both. *)
(* ADDITION AND DELETION ATTRIBUTES BIND TO THEIR ELEMENT -- NORMATIVE [CARVE-P3-017]: an addition / deletion is an ordinary inline node,
   so a trailing `{...}` attribute block attaches to its `<ins>` / `<del>`,
   exactly like a span, code span, link, or emphasis: `{+a+}{.a}` ->
   `<ins class="a">…</ins>`.

   SUBSTITUTION AND COMMENTS TAKE NONE. Substitution, editorial comment and
   braced comment have no attribute slot, so an inline attribute block after
   one matches nothing and is text:
   `{~a~>b~}{.k}` -> `<del>a</del><ins>b</ins>{.k}` and `{#c#}{.k}` ->
   `<span class="critic-comment">c</span>{.k}`. A substitution renders two
   elements and has no single one to carry attributes (attaching to both
   would repeat an `id`), and an editorial comment's content is inert
   (CARVE-P3-016). A braced comment never joins an attribute run or passes
   attachment to the preceding element, with or without intervening spaces:
   `*x*{% c %}{.k}` -> `<strong>x</strong>{.k}`. *)
(* DISAMBIGUATION (PART 9 §9 SUBSTITUTION). `{~ … ~}` is editorial
   SUBSTITUTION when it holds a `~>` at its own level, and braced
   STRIKETHROUGH otherwise. `{# … #}`
   stays editorial comment (`#` is not an emphasis delimiter, no collision). *)

(* HIGHLIGHT is the single-char `=` delimiter, and `{=text=}` is its FORCED
   intraword form (forced_highlight, PART 9 §22), rendering <mark>. It is
   distinct from the raw-inline `{=format}` attribute on a code span (e.g.
   `` `x`{=html} ``), which has no trailing `=` before the `}`. *)

(* --- Mentions and Tags --- *)
mention = '@', mention_name ;
mention_name = dotted_name ;

tag = '#', tag_name ;
tag_name = dotted_name ;

(* A mention and a tag spell the same name; only the sigil differs. *)
(* AN INERT MENTION OR TAG RENDERS ITS FULL SPELLING IN STRONG -- NORMATIVE
   [CARVE-P3-027]. With no URL template configured (PART 10 §8), the strong
   child contains the sigil and name together inside the inert span:
   `@ann` renders
   `<span class="mention"><strong>@ann</strong></span>` and `#tag` renders
   `<span class="tag"><strong>#tag</strong></span>`. *)
dotted_name = name_word, {'.', name_word} ;
name_word = (letter | digit | '_' | '-')+ ;
(* Dots are INTERIOR-only by construction: a dot followed by another name
   character continues the name (`@john.doe`, `#release-1.0`); a dot at the
   end of the run is sentence punctuation, never part of the name
   (`ping @markus.` -> mention `markus` + literal `.`). Pinned by corpus
   91-mention-and-tag-name-boundaries / 59-mention-ignores-email-addresses.
   When an enclosing inline frame has a closer beginning with a name character,
   that closer ends the mention or tag name before the name consumes it. Thus
   `{-{#x-}` closes the deletion and leaves `#x` as the tag, while a bare `#x-`
   remains a tag named `x-`. *)

(* ATTRIBUTES ON A MENTION OR TAG (normative, PART 10 §1). The node carries an
   `attrs` slot (PART 12) and those attributes RENDER, with the author's
   classes merged onto the structural `mention` / `tag` class and the
   author's own attribute order preserved after it:

     class="mention user" data-role="lead" id="x"

   On the link form the structural href is second and is never taken from an
   author attribute:

     <a class="mention user" href="…" data-role="lead" id="x">

   This is the same merge a typed div uses (`class="admonition note x"`) and
   that math uses (`class="math inline"` alongside `{.foo}`); a mention is not
   a special case.

   NOT REACHABLE FROM SOURCE, and therefore not corpus-pinnable: an attribute
   block after a mention stays literal (corpus
   153-attribute-block-after-a-mention-stays-literal), so `@alice{.x}` never
   produces an attributed mention. The slot is filled by a decoded wire
   payload, the ProseMirror bridge, or an application building the node. *)

(* Boundary rules are prose conditions on `mention`, `tag` and `symbol`,
   normative in PART 9 §7. The marker must be at start of content or preceded
   by a character outside [A-Za-z0-9_]. Whitespace and punctuation qualify:
   `(@user)` and `x=@user` contain mentions, while `a@b` does not.
   The same guard applies to `#tag` and `:symbol:`. Thus `a:b:c` and `10:30:`
   stay literal, while `(:tada:)` contains a symbol. *)

(* --- Symbols --- *)
(* A symbol is a generic named inline placeholder with NO built-in semantics:
   the parser only records the name. Resolution is processor configuration:
   (1) a registered inline-renderer extension handler for symbol nodes wins,
   (2) else the renderer `symbols` map (name -> replacement, emitted RAW in
   the target format -- processor config is trusted, same class as the
   `renderers` map), (3) else the literal text `:name:` (escaped). Emoji
   substitution is the common use, not a language feature. Profiles may
   strip or force-literal symbols ("symbol" is the construct name in
   profile allowlists).
   SYMBOL ATTRIBUTES FORCE A SPAN WRAPPER -- NORMATIVE [CARVE-P3-018]: a trailing `{...}` attribute block attaches to
   the symbol; in HTML output attributes force a `<span>` wrapper around the
   resolved (or literal) output so they have an element to land on:
   `:rocket:{.big}` -> `<span class="big">🚀</span>` (mapped) /
   `<span class="big">:rocket:</span>` (unmapped). Without attributes no
   wrapper is emitted. *)
symbol = ':', symbol_name, ':', [attribute_run] ;
symbol_name = (letter | digit | '+' | '-'), {letter | digit | '_' | '+' | '-'} ;
(* The FIRST name character is a letter, a digit, `+` or `-`, so the reaction
   shortcodes `:+1:` / `:-1:` parse (they are the most common ones in the
   wild). It may NOT be `_`: `:_x_:` would otherwise steal from underline
   (`:` + `_x_` + `:`), and no real shortcode needs a leading underscore --
   so `:_x:` stays literal text. No whitespace, no second colon inside. The
   inline extension `:type[...]` is tried first; `:kbd[Ctrl]` never parses
   as a symbol because the name run must be closed by ':'.

   PRECEDENCE vs SMART TYPOGRAPHY -- NORMATIVE [CARVE-P3-019]: a symbol is recognized BEFORE
   the typographic replacements (PART 9 §8), so a name made of typographic
   punctuation is a symbol, not a substitution: `:+-:` is the symbol `+-`
   (NOT `:` + ± + `:`), and `:--:` is the symbol `--` (NOT an en dash between
   colons). The typographic forms still apply everywhere a symbol does not
   open -- `a +- b` is `a ± b`, and `word:+-:` (no boundary, so no symbol)
   is `word:±:`. Pinned by the corpus (Symbols section). *)

(* --- Smart Typography --- *)
smart_typography = em_dash | en_dash | braced_en_dash | ellipsis | smart_quote
                 | arrow | comparison | typographic_symbol ;
(* NOTE: fractions are deliberately NOT converted (PART 9 §8 / dismissed-
   syntax.md) -- `1/2` collides with dates (`1/2/2024`) and paths. *)

em_dash = "---" ;     (* → — *)
en_dash = "--" ;      (* → – *)
braced_en_dash = "{--}" ;   (* → – *)
ellipsis = "..." ;    (* → … *)
(* A BRACED HYPHEN PAIR IS AN EN DASH, NOT AN EMPTY DELETION -- NORMATIVE [CARVE-P3-020].
   `{--}` renders a single EN DASH and the braces are consumed.
   It exists because the flanking rule below leaves a position an author cannot
   spell: a run with whitespace before it and a non-whitespace character after
   it is flag-shaped and stays literal, so `x ---That`, `x ---(p)` and
   `x ---, y` are all refused by that rule.

   `{---}` is `<del>-</del>` and `{-x-}` is `<del>x</del>`. Every other empty brace pair forms no span and no
   dash (see the empty-brace clause, CARVE-P3-014).
   There is NO braced EM dash -- `{---}` is a deletion of a hyphen -- so a
   tight em dash still has no shorthand and is written as the literal
   character. *)
(* A HYPHEN RUN OPENING A WORD AFTER WHITESPACE IS A FLAG, NOT A DASH --
   NORMATIVE [CARVE-P3-021]. A run of hyphens PRECEDED by whitespace (or the
   start of the inline content) and FOLLOWED by a non-whitespace character
   does not convert. It is literal text. Every other position converts as
   before. The case is a long CLI flag: `git log --oneline`. The start of an
   inline span's content is the start of the inline content, as for quote
   direction (CARVE-P3-023): `*--x*` keeps its run, while a `*` that opens
   nothing is the preceding character, so `2*--x` converts. A bracket run that
   stays literal is a region like a span (PART 9 §9), so its content
   starts the same way: `[--x] y` keeps its run, while `(` opens no region and
   `(--x) y` converts. A span's closing
   delimiter is not a following character: nothing follows a run at the end
   of a span's content, so `*a --*` converts as `a --` does.
   An editorial frame, either side of a substitution, an extension's content
   and an inline note's content each start content in this sense. Thus
   `2{+--x+}` keeps the hyphens in the insertion.
   Unlike quote direction, this clause reads SOURCE neighbors, so the closing
   brace of a braced comment is the preceding character: `{% c %}--x` converts.
   The backslash of a hard break or an escaped space is no following
   character: the run reads the break or space it renders (`typography_flank`),
   so `x --\` before a line break and `x --\ y` both convert.

   THE RULE IS DELIBERATELY NARROW. Requiring whitespace on BOTH sides removes
   every canonical dash use, which is unspaced -- `pages 1--10`, `the Mon--Fri
   window`, a tight `thought---interrupted---resumes`. Requiring the two SIDES
   TO MATCH in kind fails on `a---- b----- c------`, which is alphanumeric on
   the left and whitespace on the right and converts. Only the
   LEFT-FLANKING-ONLY shape -- whitespace before, word after -- is the one no
   dash wants and every flag has.

   "WHITESPACE" HERE IS `typography_flank`, below, and not the host
   language's `\s`. A VERTICAL TAB and a FORM FEED are CONTENT in Carve, so
   `---<VT>` converts or stays literal exactly as `---!` does.

   ELLIPSIS IS NOT COVERED. `wait... really` is the ordinary use and it is
   word-then-whitespace; an ellipsis terminates a clause where a dash joins two
   things, so the rule follows the construct.

   NOT FIXED BY THIS: an HTML comment survives NEITHER half. `<!-- c -->`
   renders `&lt;!– c →`. The OPENING run is preceded by `!` rather than
   whitespace, so this clause does not reach it and it converts to a dash; the
   CLOSING run is taken by `arrow` (CARVE-P3-022), and an arrow
   is matched before a hyphen run is decomposed.

   Composes with the run decomposition below rather than replacing it: this
   decides WHETHER a run converts, the length decides INTO WHAT. *)
(* HYPHEN RUNS -- a run of 2+ hyphens between non-hyphen characters
   decomposes djot-style: length divisible by 3 -> all em dashes;
   else divisible by 2 -> all en dashes; else one em dash (3) and the
   remainder by the same rule. So `--`=–, `---`=—, `----`=––,
   `-----`=—–, `------`=——, `-------`=—–– (PART 9 §8). *)

smart_quote = '"' | "'" ;
(* SMART QUOTE DIRECTION -- NORMATIVE [CARVE-P3-023].
   The PREVIOUS character is the last EMITTED character. A construct that
   renders nothing, including an empty braced comment, contributes no
   character: `\{{%%}"q"` renders `{“q”`, just as `\{"q"` does. The end of a
   closed inline element (emphasis, span, link, code, math, image, extension,
   editorial or inline note) counts as a word
   character whatever it ends in, so the quote after it CLOSES:
   `[—]{.c}"q"` renders `<span class="c">—</span>”q”`. The START of an
   inline span's content (emphasis of every kind, bare, braced or combined,
   an editorial frame, either side of a substitution, a span, a link, an
   inline note or an extension) is start-of-content, whatever precedes the span, so the
   quote there OPENS: `x.="q"=`, `x.*"q"*` and `x.*/"q"/*` all render `“q”`.
   An editorial frame, either side of a substitution, an extension's content
   and an inline note's content also start content. An inline literal and a
   raw inline count as code for the quote after them: their rendered content
   does not make a following quote open, even if it ends in `(`.
   Letters and digits are judged by Unicode code point, so a character
   outside the Basic Multilingual Plane is a letter like any other.
   An unattributed symbol is text here, its last character the previous one:
   `:a:"q"` renders `:a:“q”`, while `:a:{.x}"q"` closes after the span.

   A quote OPENS after start-of-content, a `typography_flank` character,
   or `( [ { = : - – — /`, or
   an opening curly quote `“` or `‘`. Otherwise it CLOSES. The opening set
   applies to both quote characters: `"'q'"` renders `“‘q’”`.
   A single quote before an ASCII digit is an APOSTROPHE: `'90s` renders `’90s`.

   R1. AFTER A DASH (`-`, `–`, or `—`) OR A SLASH (`/`), a quote CLOSES when
   the next source character is absent, a `typography_flank` character, or one
   of `" ' . , ; : ! ? ) ]`. Otherwise it opens. Thus `"Wait---" he said.`
   renders `“Wait—” he said.`, while `he said—"Go"` renders `he said—“Go”`.
   A path or URL that ends in a slash closes its quote: `"app/config/".`
   renders `“app/config/”.`, while `and/"or"` renders `and/“or”`.
   A hard break and an escaped space read as the `typography_flank` character
   they render, not as their backslash: `"a-"\` before a line break renders
   `“a-”<br>`, and `"a-"\ b` renders `“a-”&nbsp;b`.
   A span's closing delimiter is not the next source character: nothing
   follows a quote at the end of a span's content, so `*"Wait-"*` renders
   `<strong>“Wait-”</strong>`, as `"Wait-"` closes at the end of a paragraph.

   R2. LISTED ELISIONS. A single quote that would open and is followed by
   a maximal run of Unicode letters equal, case-insensitively, to one of
   `tis tisn twas twasn twere twill twould em cause til n bout` is an
   APOSTROPHE. EXCEPTION: if the character after that word is a single quote
   and the following character is neither a Unicode letter nor a Unicode
   number, the word is quoted. Thus `'tisn't` renders `’tisn’t`, but `'em'`
   renders `‘em’`.

   R3. SINGLE QUOTES DO NOT NEST. Scan one block's inline content in source
   order, sharing one open-single-quote state across its nested inline
   constructs. Content rendered elsewhere, including an inline footnote,
   has fresh state, is finalized separately, and leaves the surrounding
   state unchanged: `say ^['note] 'two'` keeps `‘two’` in the paragraph.
   An opening single quote before a Unicode letter or number, unless R2
   applies, is an APOSTROPHE if a span is already open; otherwise it starts
   the span. Thus `'I told 'em so,' he said.` renders `‘I told ’em so,’ he said.`
   An opener before anything else opens as usual and, if no span is open,
   starts one that is never demoted: `'*bold* text` keeps its opening quote.
   A closing single quote whose previous character is not a
   `typography_flank` character closes the span. A mid-word apostrophe (previous and next are letters or numbers,
   or next is an ASCII digit) never closes it: `'Jane's dog'` is `‘Jane’s dog’`.
   At the END OF CONTENT, demote a still-open span's opener to an apostrophe
   if it was followed by a letter or number. EXCEPTIONS: retain an opener at
   the start of the block's whole inline content (the start of a span's
   content does not count: `*'word*` gives `’word`) or directly after `“`.
   A braced inline comment at the start of the content counts as nothing, so
   the quote after it is still at the start: `{%%}'word` keeps `‘word`. Thus `say 'word` renders
   `say ’word`, while `'word` keeps `‘word` and `"'word` keeps `“‘word`.

   An APOSTROPHE is U+2019 IN EVERY LOCALE. Opening and closing quotes use
   the locale's quote glyphs. Escaped `\"` and `\'` remain straight
   characters; code, raw content, URLs and attribute values are unchanged. *)

arrow = "<--" | "-->" | "<-->"      (* ← → ↔, canonical *)
      | "<==" | "==>" | "<=>"       (* ⇐ ⇒ ⇔ *)
      | "<-" | "->" | "<->" ;       (* deprecated, still rendered *)
(* THE DOUBLED RUN IS THE CANONICAL ARROW, IN BOTH FAMILIES -- NORMATIVE [CARVE-P3-022].
   Matched longest-first, as `<->` already beats `<-`, so `<==` beats `<=` and
   `-->` beats the hyphen run. A right arrow does not start inside a longer
   hyphen run: `a--->b` is an em dash and `>`, and `a ---> b` stays a flag. `=`
   has no run rule, so `a ===> b` is `=` and the arrow. A left arrow takes
   the first two hyphens of a longer run: `a<---b` gives `a←-b`.

   `<=` KEEPS ≤. `->`, `<-` AND `<->` ARE DEPRECATED, NOT REMOVED: they
   still render, with the doubled forms canonical.
   `=>` IS REMOVED and stays ordinary text, including `key => value`,
   `x => x + 1` and `Some(x) => x`. *)
comparison = "!=" | "<=" | ">=" ;
(* NOT the `:name:` symbol above -- these are the fixed typographic
   replacements (© ® ™ ±). Named `typographic_symbol` so the two do not
   collide: `symbol` is the `:name:` placeholder (PART 9 §7). *)
typographic_symbol = "(c)" | "(r)" | "(tm)" | "+-" ;

(* --- Breaks --- *)
hard_break = '\', ( newline | EOF | cell_content_end ) ;
  (* backslash at the end of a line, of the document or of a trimmed table
     cell (PART 9 §9's escape row) *)
cell_content_end = (* the end of a table cell's content after trimming *) ;
soft_break = newline ;        (* regular line ending within paragraph *)

(* TYPOGRAPHY FLANK. The one class smart typography reads a neighbor
   character through, for dash runs (CARVE-P3-021) and quote direction
   (CARVE-P3-023): space, tab, line feed, carriage return, no-break space
   U+00A0, and a soft or hard line break. An escaped space renders U+00A0, so
   it is in the class. THE CLASS IS CLOSED: every other
   Unicode space, U+2000 to U+200A, U+202F and U+3000 among them, is a word
   character here. So a quote after U+202F closes, as French spacing inside
   the marks needs, and a quote after U+3000 closes too. *)
typography_flank = whitespace | newline | no_break_space | soft_break | hard_break ;
no_break_space = (* U+00A0 NO-BREAK SPACE *) ;
