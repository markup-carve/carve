{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://markup-carve.github.io/carve/render-loss-report.schema.json",
  "title": "Carve render loss report",
  "$defs": {
    "pos": {
      "type": "object",
      "required": ["startLine", "endLine", "startColumn", "endColumn", "startOffset", "endOffset"],
      "properties": {
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "startColumn": { "type": "integer", "minimum": 1 },
        "endColumn": { "type": "integer", "minimum": 1 },
        "startOffset": { "type": "integer", "minimum": 0 },
        "endOffset": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["losses", "totalLosses", "truncated"],
  "properties": {
    "file": { "type": "string" },
    "losses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "target", "nodeType", "message"],
        "properties": {
          "code": { "enum": ["raw-format-dropped", "ruby-flattened", "destination-denied", "editorial-comment-flattened", "carrier-attribute-dropped", "list-style-dropped", "list-delimiter-changed", "table-span-flattened", "table-header-row-demoted"] },
          "attribute": { "type": "string" },
          "style": { "enum": ["lower-alpha", "upper-alpha", "lower-roman", "upper-roman"] },
          "delim": { "enum": [".", ")"] },
          "emittedDelim": { "enum": [".", ")"] },
          "colspan": { "type": "integer", "minimum": 2 },
          "rowspan": { "type": "integer", "minimum": 2 },
          "format": { "type": "string" },
          "target": { "enum": ["html", "markdown", "plain", "ansi", "carve"] },
          "nodeType": { "enum": ["inline", "block"] },
          "message": { "type": "string" },
          "pos": { "$ref": "#/$defs/pos" }
        },
        "if": { "properties": { "code": { "const": "table-span-flattened" } }, "required": ["code"] },
        "else": { "properties": { "colspan": false, "rowspan": false } },
        "oneOf": [
          {
            "properties": {
              "code": { "const": "carrier-attribute-dropped" },
              "attribute": { "type": "string" },
              "target": { "const": "html" },
              "format": false
            },
            "required": ["attribute"]
          },
          {
            "properties": {
              "code": { "const": "raw-format-dropped" },
              "format": { "type": "string" }
            },
            "required": ["format"]
          },
          {
            "properties": {
              "code": { "const": "ruby-flattened" },
              "nodeType": { "const": "inline" },
              "format": false
            }
          },
          {
            "properties": {
              "code": { "const": "destination-denied" },
              "nodeType": { "const": "inline" },
              "format": false,
              "message": {
                "enum": ["Blanked a denied destination scheme", "Blanked a denied image source"]
              }
            }
          },
          {
            "properties": {
              "code": { "const": "editorial-comment-flattened" },
              "nodeType": { "const": "inline" },
              "format": false,
              "message": { "const": "Flattened an editorial comment into the surrounding text" }
            }
          },
          {
            "properties": {
              "code": { "const": "list-style-dropped" },
              "style": { "enum": ["lower-alpha", "upper-alpha", "lower-roman", "upper-roman"] },
              "target": { "const": "markdown" },
              "nodeType": { "const": "block" },
              "format": false
            },
            "required": ["style"]
          },
          {
            "properties": {
              "code": { "const": "list-delimiter-changed" },
              "delim": { "enum": [".", ")"] },
              "emittedDelim": { "enum": [".", ")"] },
              "target": { "const": "markdown" },
              "nodeType": { "const": "block" },
              "format": false
            },
            "required": ["delim", "emittedDelim"]
          },
          {
            "properties": {
              "code": { "const": "table-span-flattened" },
              "attribute": false,
              "style": false,
              "delim": false,
              "emittedDelim": false,
              "target": { "enum": ["markdown", "plain", "ansi"] },
              "nodeType": { "const": "block" },
              "format": false,
              "colspan": { "type": "integer", "minimum": 2 },
              "rowspan": { "type": "integer", "minimum": 2 },
              "message": { "const": "Flattened a spanning table cell into separate cells" }
            },
            "anyOf": [
              { "properties": { "colspan": { "type": "integer" } }, "required": ["colspan"] },
              { "properties": { "rowspan": { "type": "integer" } }, "required": ["rowspan"] }
            ]
          },
          {
            "properties": {
              "code": { "const": "table-header-row-demoted" },
              "attribute": false,
              "style": false,
              "delim": false,
              "emittedDelim": false,
              "target": { "const": "markdown" },
              "nodeType": { "const": "block" },
              "format": false,
              "colspan": false,
              "rowspan": false,
              "message": { "const": "Wrote a later header row as a body row" }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "totalLosses": { "type": "integer", "minimum": 0 },
    "truncated": { "type": "boolean" }
  },
  "additionalProperties": false
}
