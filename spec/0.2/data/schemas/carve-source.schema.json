{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "carve.source value",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "locator",
    "importer"
  ],
  "properties": {
    "format": {
      "type": "string",
      "minLength": 1
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "part": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "importer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
