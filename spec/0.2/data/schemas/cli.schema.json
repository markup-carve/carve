{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Carve 0.2 command line and library",
  "description": "The commands, flags, failure categories, library calls and diagnostic entry fields of tooling.md (C2-T-004). Every list is sorted by name, by code point.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "commands",
    "flags",
    "categories",
    "library",
    "entry_fields"
  ],
  "properties": {
    "$schema": {
      "const": "schemas/cli.schema.json"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "specified",
          "expands",
          "clauses"
        ],
        "properties": {
          "name": {
            "enum": [
              "ast",
              "diagnostics",
              "fix",
              "flatten",
              "fmt",
              "import",
              "lint",
              "migrate-ast",
              "render",
              "upgrade"
            ],
            "description": "The command as it is typed after the program name (C2-T-007)."
          },
          "flags_of": {
            "enum": [
              "lint"
            ],
            "description": "A command that takes the flags of the table of another command and lists none of its own (C2-T-049)."
          },
          "specified": {
            "type": "boolean",
            "description": "false for a command this specification names but does not define (C2-T-003): its flags are not listed."
          },
          "expands": {
            "type": "boolean",
            "description": "Whether the command expands includes by default (C2-T-018)."
          },
          "clauses": {
            "type": "array",
            "minItems": 0,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^C2-[ABHILMNTWX]-[0-9]{3}$"
            },
            "description": "The clause ids of the 0.2 documents that the row encodes. The row is normative together with these clauses."
          }
        }
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "commands",
          "kind",
          "clauses"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "The flag without its leading `--`."
          },
          "commands": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "ast",
                "diagnostics",
                "fix",
                "flatten",
                "fmt",
                "import",
                "lint",
                "migrate-ast",
                "render",
                "upgrade"
              ]
            },
            "description": "The commands whose table lists the flag, sorted."
          },
          "kind": {
            "enum": [
              "switch",
              "enum",
              "json",
              "path",
              "count",
              "code",
              "file"
            ],
            "description": "`switch`: no value, `--no-` turns it off (C2-T-008); `enum`: one of `values`; `json`: JSON text; `path`: a file path or `-` (C2-T-015); `count`: a decimal integer of at least 0; `code`: a code of data/lint-rules.json; `file`: a file id (C2-N-009) or a file name as given (C2-T-013)."
          },
          "channel": {
            "enum": ["parse", "render-loss", "lint"],
            "description": "For a `code` flag: the channel of data/lint-rules.json whose codes the flag takes; the ids of the rows with that `channel` are the list of valid values (C2-T-027)."
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            },
            "description": "The values of an `enum` flag."
          },
          "option": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z]*$",
            "description": "The row of data/options.json the flag sets (C2-T-010). Its default is the default of that option."
          },
          "default": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ],
            "description": "The value without the flag, for a flag that sets no option and has one."
          },
          "repeatable": {
            "const": true,
            "description": "Every value is collected (C2-T-009)."
          },
          "short": {
            "type": "string",
            "pattern": "^-[a-z]$",
            "description": "A one-letter spelling of the same flag."
          },
          "clauses": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^C2-[ABHILMNTWX]-[0-9]{3}$"
            },
            "description": "The clause ids of the 0.2 documents that the row encodes. The row is normative together with these clauses."
          }
        }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "errors",
          "clauses"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "The CATEGORY of `carve[CATEGORY]:` (C2-T-039)."
          },
          "status": {
            "enum": [
              1,
              2
            ],
            "description": "The exit status of a file that fails with the category."
          },
          "errors": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Za-z]*Error$"
            },
            "description": "The library errors that become the category (C2-T-006); empty where the category has none."
          },
          "clauses": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^C2-[ABHILMNTWX]-[0-9]{3}$"
            },
            "description": "The clause ids of the 0.2 documents that the row encodes. The row is normative together with these clauses."
          }
        }
      }
    },
    "library": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "clauses"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z]*$",
            "description": "The call as the reference engine spells it (C2-T-001)."
          },
          "clauses": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^C2-[ABHILMNTWX]-[0-9]{3}$"
            },
            "description": "The clause ids of the 0.2 documents that the row encodes. The row is normative together with these clauses."
          }
        }
      }
    },
    "entry_fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "always",
          "library",
          "clauses"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z]*$",
            "description": "The member of an entry in JSON (C2-T-020)."
          },
          "always": {
            "type": "boolean",
            "description": "Whether every entry has the field."
          },
          "library": {
            "type": "boolean",
            "description": "false for a field only the command line adds."
          },
          "clauses": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^C2-[ABHILMNTWX]-[0-9]{3}$"
            },
            "description": "The clause ids of the 0.2 documents that the row encodes. The row is normative together with these clauses."
          }
        }
      }
    }
  }
}
