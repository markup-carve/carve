{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["$schema", "source", "tree"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"const": "schemas/upgrade-map.schema.json"},
    "source": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "tree": {"type": "array", "items": {"$ref": "#/$defs/tree"}}
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["id", "kind", "group", "from", "to", "meaning02", "toolEntry", "silent"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^U-[0-9]{3}$"},
        "kind": {"enum": ["rewrite", "escape", "report", "none"]},
        "group": {"type": "string"},
        "from": {"type": "string"},
        "to": {"type": "string"},
        "meaning02": {"type": "string"},
        "toolEntry": {"type": "string", "pattern": "^U-[0-9]{3}$"},
        "silent": {"type": "boolean"}
      }
    },
    "tree": {
      "type": "object",
      "required": ["id", "kind", "from", "to", "migrationRule", "silent"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^T-[0-9]{3}$"},
        "kind": {"enum": ["migration", "version", "rename", "move", "merge", "split", "drop", "add"]},
        "from": {"type": "string"},
        "to": {"type": "string"},
        "migrationRule": {"type": "string"},
        "silent": {"type": "boolean"}
      }
    }
  }
}
