      "closes_on": ["closer", "container_end"],
      "body": "opaque",
      "strip": "opener_indent",
      "unclosed_report": "unclosed-code-fence",
      "clauses": ["C2-B-007", "C2-B-029", "C2-B-109", "C2-B-110", "C2-B-111", "C2-B-112", "C2-B-113", "C2-B-114", "C2-B-135"]
