{
  "$schema": "schemas/smart-punctuation.schema.json",
  "runs": [
    { "source": "!=", "replaced": true, "kind": "not_equal", "glyph": "≠", "clauses": ["C2-I-117"] },
    { "source": "(c)", "replaced": false, "clauses": ["C2-I-117"] },
    { "source": "(r)", "replaced": false, "clauses": ["C2-I-117"] },
    { "source": "(tm)", "replaced": true, "kind": "trademark", "glyph": "™", "clauses": ["C2-I-117"] },
    { "source": "+-", "replaced": true, "kind": "plus_minus", "glyph": "±", "clauses": ["C2-I-117"] },
    {
      "source": "-->",
      "replaced": true,
      "kind": "rightwards_arrow",
      "glyph": "→",
      "clauses": ["C2-I-115", "C2-I-116"]
    },
    { "source": "->", "replaced": false, "clauses": ["C2-I-115"] },
    { "source": "...", "replaced": true, "kind": "ellipsis", "glyph": "…", "clauses": ["C2-I-114"] },
    { "source": "<-", "replaced": false, "clauses": ["C2-I-115"] },
    {
      "source": "<--",
      "replaced": true,
      "kind": "leftwards_arrow",
      "glyph": "←",
      "clauses": ["C2-I-115", "C2-I-116"]
    },
    {
      "source": "<-->",
      "replaced": true,
      "kind": "left_right_arrow",
      "glyph": "↔",
      "clauses": ["C2-I-115", "C2-I-116"]
    },
    { "source": "<=", "replaced": true, "kind": "less_than_or_equal", "glyph": "≤", "clauses": ["C2-I-117"] },
    { "source": "<==", "replaced": true, "kind": "leftwards_double_arrow", "glyph": "⇐", "clauses": ["C2-I-115"] },
    { "source": "<=>", "replaced": true, "kind": "left_right_double_arrow", "glyph": "⇔", "clauses": ["C2-I-115"] },
    { "source": "==>", "replaced": true, "kind": "rightwards_double_arrow", "glyph": "⇒", "clauses": ["C2-I-115"] },
    { "source": "=>", "replaced": false, "clauses": ["C2-I-115"] },
    { "source": ">=", "replaced": true, "kind": "greater_than_or_equal", "glyph": "≥", "clauses": ["C2-I-117"] }
  ],
  "quotes": [
    { "kind": "left_double_quote", "source": "\"", "glyph": "“", "clauses": ["C2-I-104"] },
    { "kind": "left_single_quote", "source": "'", "glyph": "‘", "clauses": ["C2-I-104", "C2-I-109"] },
    { "kind": "right_double_quote", "source": "\"", "glyph": "”", "clauses": ["C2-I-104", "C2-I-106"] },
    {
      "kind": "right_single_quote",
      "source": "'",
      "glyph": "’",
      "apostrophe": true,
      "clauses": ["C2-I-104", "C2-I-105", "C2-I-106", "C2-I-107", "C2-I-109"]
    }
  ],
  "dashes": [
    { "kind": "em_dash", "source": "---", "glyph": "—", "clauses": ["C2-I-111"] },
    { "kind": "en_dash", "source": "--", "glyph": "–", "clauses": ["C2-I-111"] }
  ],
  "quote_opens_after": {
    "positions": ["content_start", "whitespace", "no_break_space", "opening_curly_quote", "hyphen_or_dash"],
    "chars": ["(", "/", ":", "=", "[", "{"],
    "clauses": ["C2-I-104"]
  },
  "quote_closes_after_hyphen_dash_or_slash_before": {
    "positions": ["content_end", "whitespace"],
    "chars": ["!", "\"", "'", ")", ",", ".", ":", ";", "?", "]"],
    "clauses": ["C2-I-106"]
  },
  "apostrophe_words": {
    "words": ["bout", "cause", "em", "n", "til", "tis", "tisn", "twas", "twasn", "twere", "twill", "twould"],
    "letter_case": "any",
    "clauses": ["C2-I-107", "C2-I-108"]
  },
  "hyphen_run": {
    "min": 2,
    "divisible_by_3": "em_dashes",
    "divisible_by_2": "en_dashes",
    "otherwise": "one_em_dash_then_rest_by_same_rule",
    "clauses": ["C2-I-111", "C2-I-116"]
  }
}
