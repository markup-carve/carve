{
  "$schema": "schemas/options.schema.json",
  "options": [
    {
      "name": "adapter",
      "kind": "import",
      "read_by": "import",
      "type": "enum",
      "values": ["generic", "tiptap", "prosemirror", "ckeditor", "tinymce", "word", "google-docs"],
      "default": "generic",
      "clauses": ["C2-H-137", "C2-M-102"]
    },
    {
      "name": "alignTables",
      "kind": "format",
      "read_by": "format",
      "type": "boolean",
      "default": false,
      "clauses": ["C2-H-137", "C2-W-068", "C2-W-118", "C2-W-119"]
    },
    {
      "name": "allowLosses",
      "kind": "render",
      "read_by": ["import", "render"],
      "type": "list",
      "items": "code of the render-loss channel of lint-rules.json",
      "default": [],
      "clauses": ["C2-H-137", "C2-H-204", "C2-T-027"]
    },
    {
      "name": "codeBlockRenderer",
      "kind": "render",
      "read_by": "render",
      "type": "structure",
      "holds": "a host function from a code block node and its default HTML to trusted HTML or nothing",
      "default": null,
      "clauses": ["C2-H-137", "C2-H-206", "C2-H-207"]
    },
    {
      "name": "extensions",
      "kind": "parse",
      "read_by": ["format", "lint", "parse", "tree"],
      "type": "list",
      "items": "extension",
      "default": [],
      "clauses": ["C2-H-137", "C2-T-005", "C2-X-038"]
    },
    {
      "name": "headingIds",
      "kind": "resolution",
      "read_by": ["lint", "resolve"],
      "type": "enum",
      "values": ["off", "keep-case", "lower", "ascii", "ascii-lower", "ascii-strict", "ascii-strict-lower"],
      "default": "keep-case",
      "clauses": ["C2-H-131", "C2-H-137", "C2-T-005"]
    },
    {
      "name": "headingShift",
      "kind": "render",
      "read_by": ["export-markdown", "render"],
      "type": "count",
      "maximum": 5,
      "default": 0,
      "clauses": ["C2-H-137", "C2-H-208", "C2-H-209", "C2-T-010"]
    },
    {
      "name": "includes",
      "kind": "parse",
      "read_by": "parse",
      "type": "structure",
      "holds": "include root or resolver, with its limits",
      "default": null,
      "clauses": ["C2-H-133", "C2-H-137", "C2-N-003"]
    },
    {
      "name": "labels",
      "kind": "render",
      "read_by": ["import", "render"],
      "type": "map",
      "keys": "label key",
      "items": "text",
      "default": {
        "footnoteBacklink": "Back to reference",
        "indexBackref": "Back to",
        "tabsGroup": "Tabs",
        "codeGroup": "Code examples",
        "endnotes": "Footnotes",
        "tocNav": "Table of contents",
        "admonitionNote": "Note",
        "admonitionTip": "Tip",
        "admonitionWarning": "Warning",
        "admonitionDanger": "Danger",
        "admonitionInfo": "Info",
        "admonitionSuccess": "Success",
        "admonitionExample": "Example",
        "admonitionQuote": "Quote"
      },
      "clauses": ["C2-H-091", "C2-H-125", "C2-H-137", "C2-H-155", "C2-M-101"]
    },
    {
      "name": "maxLosses",
      "kind": "render",
      "read_by": ["import", "render"],
      "type": "count",
      "default": 100,
      "clauses": ["C2-H-137", "C2-H-205", "C2-T-029"]
    },
    {
      "name": "mode",
      "kind": "render",
      "read_by": "render",
      "type": "enum",
      "values": ["interactive", "static"],
      "default": "interactive",
      "clauses": ["C2-H-122", "C2-H-137"]
    },
    {
      "name": "normalize",
      "kind": "format",
      "read_by": "format",
      "type": "boolean",
      "default": false,
      "clauses": ["C2-H-137", "C2-W-127"]
    },
    {
      "name": "platforms",
      "kind": "lint",
      "read_by": "lint",
      "type": "list",
      "items": "platform name",
      "values": ["github"],
      "default": [],
      "clauses": ["C2-H-137", "C2-W-109"]
    },
    {
      "name": "profile",
      "kind": "render",
      "read_by": "render",
      "type": "enum",
      "values": ["full", "article", "comment", "minimal"],
      "default": "full",
      "clauses": ["C2-H-129", "C2-H-137", "C2-H-163"]
    },
    {
      "name": "rawHtml",
      "kind": "render",
      "read_by": ["import", "render"],
      "type": "boolean",
      "default": false,
      "clauses": ["C2-H-127", "C2-H-137", "C2-M-066"]
    },
    {
      "name": "renderers",
      "kind": "render",
      "read_by": "render",
      "type": "map",
      "keys": "extension name",
      "items": "renderer",
      "default": {},
      "clauses": ["C2-H-123", "C2-H-137"]
    },
    {
      "name": "roundtrip",
      "kind": "render",
      "read_by": "render",
      "type": "boolean",
      "default": false,
      "clauses": ["C2-H-127", "C2-H-137"]
    },
    {
      "name": "rules",
      "kind": "lint",
      "read_by": "lint",
      "type": "map",
      "keys": "rule id",
      "items": "on or off",
      "default_from": "lint-rules.json",
      "clauses": ["C2-H-137", "C2-W-109"]
    },
    {
      "name": "sections",
      "kind": "render",
      "read_by": "render",
      "type": "boolean",
      "default": true,
      "clauses": ["C2-H-127", "C2-H-137"]
    },
    {
      "name": "smartTypography",
      "kind": "render",
      "read_by": "render",
      "type": "boolean",
      "default": true,
      "clauses": ["C2-H-127", "C2-H-137"]
    },
    {
      "name": "social",
      "kind": "render",
      "read_by": "render",
      "type": "structure",
      "holds": "mentionUrl and tagUrl, URL templates in which {name} stands for the percent-encoded name and any other placeholder of letters, digits or underscores in braces is an option error; resolveMention and resolveTag, host functions from an object with kind, name and context to a URL, which replace the template of their pair; and context, a host value passed to the resolvers unchanged",
      "default": null,
      "clauses": ["C2-H-126", "C2-H-137"]
    },
    {
      "name": "softBreak",
      "kind": "render",
      "read_by": "render",
      "type": "enum",
      "values": ["newline", "space", "br"],
      "default": "newline",
      "clauses": ["C2-H-045", "C2-H-137", "C2-H-203"]
    },
    {
      "name": "sourceLines",
      "kind": "render",
      "read_by": "render",
      "type": "boolean",
      "default": false,
      "clauses": ["C2-H-127", "C2-H-137"]
    },
    {
      "name": "strictLosses",
      "kind": "render",
      "read_by": ["import", "render"],
      "type": "boolean",
      "default": false,
      "clauses": ["C2-H-130", "C2-H-137", "C2-M-082"]
    },
    {
      "name": "symbols",
      "kind": "render",
      "read_by": "render",
      "type": "map",
      "keys": "symbol name",
      "items": "output",
      "default": {},
      "clauses": ["C2-H-124", "C2-H-137"]
    },
    {
      "name": "upgrade",
      "kind": "lint",
      "read_by": "lint",
      "type": "boolean",
      "default": false,
      "clauses": ["C2-H-137", "C2-W-156"]
    },
    {
      "name": "urlPolicy",
      "kind": "render",
      "read_by": "render",
      "type": "structure",
      "holds": "deny list or allow list of URL schemes",
      "default": {
        "deny": [
          "javascript",
          "vbscript",
          "data",
          "file",
          "ms-msdt",
          "ms-office",
          "ms-word",
          "ms-excel",
          "ms-powerpoint",
          "ms-access",
          "ms-visio",
          "ms-project",
          "ms-publisher",
          "ms-infopath",
          "ms-spd",
          "ms-search",
          "search-ms",
          "ms-cxh",
          "ms-cxh-full",
          "shell",
          "vscode",
          "vscode-insiders",
          "jar"
        ]
      },
      "clauses": ["C2-H-128", "C2-H-137", "C2-H-159", "C2-H-160"]
    }
  ]
}
