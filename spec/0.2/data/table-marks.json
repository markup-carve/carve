{
  "$schema": "schemas/table-marks.schema.json",
  "cell_split": {
    "separator": "|",
    "not_a_separator": ["escaped_pipe", "pipe_between_backtick_run_and_matching_run_on_same_line"],
    "before": "reading_cell_content",
    "clauses": ["C2-B-134", "C2-B-169"]
  },
  "cell_prefix": {
    "sequence": [
      { "part": "optional", "mark": "|=" },
      { "part": "optional", "ref": "brace_block" },
      { "part": "optional", "sequence": [{ "part": "space", "min": 1 }] }
    ],
    "clauses": ["C2-B-171"]
  },
  "header_cell_mark": { "mark": "|=", "head": "leading_rows_of_only_header_cells", "clauses": ["C2-B-171", "C2-B-178"] },
  "span_marks": [
    { "mark": "<", "joins": "cell_to_left", "failed": "empty_cell", "clauses": ["C2-B-172", "C2-B-173", "C2-B-183"] },
    {
      "mark": "^",
      "joins": "cell_above",
      "failed": "empty_cell",
      "blocked_by": ["head_boundary"],
      "clauses": ["C2-B-172", "C2-B-173", "C2-B-174", "C2-B-183"]
    }
  ],
  "continuation_fragment": {
    "joins": "cell_of_its_column_in_row_above",
    "joined_with": " ",
    "empty_fragment": "adds_nothing",
    "under_span_mark": "cell_that_covers_the_column_after_spans_resolve",
    "under_failed_span_mark": "empty_cell_the_mark_leaves",
    "past_last_column": "new_cell",
    "reads": [],
    "clauses": ["C2-B-173", "C2-B-176", "C2-B-184", "C2-B-185"]
  },
  "alignment_marks": [
    { "mark": "<", "alignment": "left", "clauses": ["C2-B-182"] },
    { "mark": ">", "alignment": "right", "clauses": ["C2-B-182"] },
    { "mark": "~", "alignment": "center", "clauses": ["C2-B-182"] }
  ],
  "attributes": [
    {
      "name": "aligns",
      "applies_to": ["delimited_table", "pipe_table"],
      "value": "alignment_list",
      "entries": ["center", "left", "right"],
      "sets": "table_column.align",
      "written_to_html": false,
      "report": "table-column-arity",
      "clauses": ["C2-B-187", "C2-B-211", "C2-B-213", "C2-H-153"]
    },
    {
      "name": "footer-rows",
      "applies_to": ["delimited_table", "pipe_table"],
      "value": "count",
      "written_to_html": false,
      "clauses": ["C2-B-187", "C2-B-210", "C2-H-153"]
    },
    {
      "name": "header-cols",
      "applies_to": ["list_table"],
      "no_effect_on": ["delimited_table", "pipe_table"],
      "value": "count",
      "written_to_html": true,
      "clauses": ["C2-B-187", "C2-B-214"]
    },
    {
      "name": "header-rows",
      "applies_to": ["delimited_table", "list_table"],
      "no_effect_on": ["pipe_table"],
      "value": "count",
      "written_to_html": false,
      "report": "deprecated-table-attribute",
      "clauses": ["C2-B-179", "C2-B-186", "C2-B-209", "C2-H-153"]
    },
    {
      "name": "table",
      "applies_to": ["csv_fence", "tsv_fence"],
      "value": "flag",
      "written_to_html": false,
      "report": "delimited-table-malformed",
      "clauses": ["C2-B-180", "C2-B-181"]
    },
    {
      "name": "widths",
      "applies_to": ["delimited_table", "pipe_table"],
      "value": "width_list",
      "sets": "table_column.width",
      "written_to_html": false,
      "report": "table-width-total",
      "clauses": ["C2-B-187", "C2-B-212", "C2-H-059", "C2-H-153"]
    }
  ]
}
