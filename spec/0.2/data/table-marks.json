{
  "$schema": "schemas/table-marks.schema.json",
  "cell_split": {
    "separator": "|",
    "not_a_separator": ["escaped_pipe", "pipe_between_backtick_run_and_matching_run_on_same_line"],
    "before": "reading_cell_content",
    "clauses": ["C2-B-169", "C2-B-223"]
  },
  "cell_prefix": {
    "sequence": [
      { "part": "optional", "mark": "|=" },
      { "part": "optional", "ref": "brace_blocks" },
      { "part": "optional", "sequence": [{ "part": "space", "min": 1 }] }
    ],
    "clauses": ["C2-B-093", "C2-B-171"]
  },
  "header_cell_mark": { "mark": "|=", "followed_by": ["<", ">", "?", "cell_end", "space", "tab", "{", "~"], "otherwise": "equals_sign_is_cell_text", "head": "leading_rows_with_a_header_cell_and_no_other_cell", "clauses": ["C2-B-171", "C2-B-178"] },
  "span_marks": [
    {
      "mark": "<",
      "joins": "cell_to_left",
      "failed": "cell_with_the_mark_as_text",
      "blocked_by": ["first_column", "left_cell_covered_by_row_span"],
      "clauses": ["C2-B-172", "C2-B-173", "C2-B-174", "C2-B-183"]
    },
    {
      "mark": "^",
      "joins": "cell_above",
      "failed": "cell_with_the_mark_as_text",
      "blocked_by": ["first_row_of_group", "cell_above_spans_columns"],
      "clauses": ["C2-B-172", "C2-B-173", "C2-B-174", "C2-B-183"]
    }
  ],
  "continuation_fragment": {
    "joins": "cell_of_its_column_in_row_above",
    "joined_with": " ",
    "empty_fragment": "adds_nothing",
    "under_span_mark": "cell_that_covers_the_column_after_spans_resolve",
    "under_failed_span_mark": "cell_that_holds_the_mark",
    "past_last_column": "new_cell",
    "reads": [],
    "clauses": ["C2-B-173", "C2-B-176", "C2-B-184", "C2-B-185"]
  },
  "alignment_marks": [
    { "mark": "<", "alignment": "left", "clauses": ["C2-B-182"] },
    { "mark": ">", "alignment": "right", "clauses": ["C2-B-182"] },
    { "mark": "?", "alignment": "none", "only_before": "vertical_mark", "clauses": ["C2-B-182", "C2-B-213"] },
    { "mark": "~", "alignment": "center", "clauses": ["C2-B-182"] }
  ],
  "vertical_marks": [
    { "mark": "^", "alignment": "top", "after": "alignment_mark", "clauses": ["C2-B-182"] },
    { "mark": "v", "alignment": "bottom", "after": "alignment_mark", "clauses": ["C2-B-182"] },
    { "mark": "~", "alignment": "middle", "after": "alignment_mark", "clauses": ["C2-B-182"] }
  ],
  "attributes": [
    {
      "name": "aligns",
      "applies_to": ["delimited_table", "pipe_table"],
      "value": "alignment_list",
      "entries": ["center", "left", "right"],
      "sets": "table_column.align",
      "written_to_html": false,
      "report": "table-attribute-invalid",
      "clauses": ["C2-B-187", "C2-B-211", "C2-B-213", "C2-B-227", "C2-H-153"]
    },
    {
      "name": "body-header-cols",
      "applies_to": ["delimited_table", "pipe_table"],
      "value": "count_list",
      "sets": "table_body.rowHeadColumns",
      "written_to_html": false,
      "report": "table-attribute-invalid",
      "clauses": ["C2-B-227", "C2-B-230", "C2-H-056", "C2-H-153"]
    },
    {
      "name": "body-header-rows",
      "applies_to": ["delimited_table", "pipe_table"],
      "value": "count_list",
      "sets": "table_cell.header",
      "written_to_html": false,
      "report": "table-attribute-invalid",
      "clauses": ["C2-B-227", "C2-B-230", "C2-H-153"]
    },
    {
      "name": "body-rows",
      "applies_to": ["delimited_table", "pipe_table"],
      "value": "count_list",
      "written_to_html": false,
      "report": "table-attribute-invalid",
      "clauses": ["C2-B-174", "C2-B-227", "C2-B-230", "C2-H-055", "C2-H-153"]
    },
    {
      "name": "footer-rows",
      "applies_to": ["delimited_table", "pipe_table"],
      "value": "count",
      "written_to_html": false,
      "clauses": ["C2-B-187", "C2-B-210", "C2-B-227", "C2-H-153"]
    },
    {
      "name": "header-cols",
      "applies_to": [],
      "no_effect_on": ["delimited_table", "pipe_table"],
      "value": "count",
      "written_to_html": true,
      "clauses": ["C2-B-187", "C2-B-214"]
    },
    {
      "name": "header-rows",
      "applies_to": ["delimited_table"],
      "no_effect_on": ["pipe_table"],
      "value": "count",
      "written_to_html": false,
      "report": "deprecated-table-attribute",
      "clauses": ["C2-B-179", "C2-B-186", "C2-B-209", "C2-B-227", "C2-H-153"]
    },
    {
      "name": "table",
      "applies_to": ["csv_fence", "tsv_fence"],
      "value": "flag",
      "written_to_html": false,
      "report": "delimited-table-malformed",
      "clauses": ["C2-B-180", "C2-B-181"]
    },
    {
      "name": "valigns",
      "applies_to": ["delimited_table", "pipe_table"],
      "value": "alignment_list",
      "entries": ["bottom", "middle", "top"],
      "sets": "table_column.valign",
      "written_to_html": false,
      "report": "table-attribute-invalid",
      "clauses": ["C2-B-187", "C2-B-211", "C2-B-213", "C2-B-227", "C2-H-153"]
    },
    {
      "name": "widths",
      "applies_to": ["delimited_table", "pipe_table"],
      "value": "width_list",
      "sets": "table_column.width",
      "written_to_html": false,
      "report": "table-width-total",
      "clauses": ["C2-B-187", "C2-B-212", "C2-B-227", "C2-H-152", "C2-H-153"]
    }
  ]
}
