{
  "version": 1,
  "sourcePath": "doc.crv",
  "vectors": [
    {
      "name": "code-table-malformed-record",
      "description": "The ticket control: a malformed record in a {table} csv code include is reported at its line in the csv file, reached from the directive.",
      "resolver": "virtual",
      "entry": "{table}\n{{ data/plans.csv @code:csv }}\n",
      "files": {
        "data/plans.csv": "Plan,Seats,Price\nStarter,1,\"$0\"\nTeam,10,\"$49\" billed yearly\n"
      },
      "expected": {
        "findings": [
          {
            "rule": "delimited-table-malformed",
            "file": "data/plans.csv",
            "line": 3,
            "column": 1,
            "includedBy": [
              {
                "file": "doc.crv",
                "line": 2,
                "column": 1
              }
            ]
          }
        ]
      }
    },
    {
      "name": "code-table-wide-record",
      "description": "The first record wider than the first record is reported at its own line.",
      "resolver": "virtual",
      "entry": "{table}\n{{ data/wide.csv @code:csv }}\n",
      "files": {
        "data/wide.csv": "a,b\nc,d\ne,f,g\nh,i,j\n"
      },
      "expected": {
        "findings": [
          {
            "rule": "delimited-table-wide-row",
            "file": "data/wide.csv",
            "line": 3,
            "column": 1,
            "includedBy": [
              {
                "file": "doc.crv",
                "line": 2,
                "column": 1
              }
            ]
          }
        ]
      }
    },
    {
      "name": "code-table-lines-keep-file-coordinates",
      "description": "A payload selected by @lines reports in the coordinates of the file, not of the selection.",
      "resolver": "virtual",
      "entry": "{table}\n{{ data/rows.csv @code:tsv @lines:3-5 }}\n",
      "files": {
        "data/rows.csv": "skipped \"\nskipped\na\tb\nc\td\te\nf\tg\n"
      },
      "expected": {
        "findings": [
          {
            "rule": "delimited-table-wide-row",
            "file": "data/rows.csv",
            "line": 4,
            "column": 1,
            "includedBy": [
              {
                "file": "doc.crv",
                "line": 2,
                "column": 1
              }
            ]
          }
        ]
      }
    },
    {
      "name": "code-include-without-table-is-not-read",
      "description": "Without a {table} attribute line the payload is code, and no payload rule runs.",
      "resolver": "virtual",
      "entry": "{{ data/bad.csv @code:csv }}\n",
      "files": {
        "data/bad.csv": "a,b\n\"x\n"
      },
      "expected": {
        "findings": []
      }
    },
    {
      "name": "carve-include-is-linted",
      "description": "Every rule runs on a Carve-mode include; the finding names the child and the directive.",
      "resolver": "virtual",
      "entry": "Intro.\n\n{{ part.crv }}\n",
      "files": {
        "part.crv": "Text.\n\n>quoted\n"
      },
      "expected": {
        "findings": [
          {
            "rule": "blockquote-marker-without-space",
            "file": "part.crv",
            "line": 3,
            "column": 1,
            "includedBy": [
              {
                "file": "doc.crv",
                "line": 3,
                "column": 1
              }
            ]
          }
        ]
      }
    },
    {
      "name": "top-level-findings-are-unchanged",
      "description": "The top-level document reports as without includes, with no chain.",
      "resolver": "virtual",
      "entry": ">root\n\n{{ part.crv }}\n",
      "files": {
        "part.crv": ">child\n"
      },
      "expected": {
        "findings": [
          {
            "rule": "blockquote-marker-without-space",
            "file": "doc.crv",
            "line": 1,
            "column": 1
          },
          {
            "rule": "blockquote-marker-without-space",
            "file": "part.crv",
            "line": 1,
            "column": 1,
            "includedBy": [
              {
                "file": "doc.crv",
                "line": 3,
                "column": 1
              }
            ]
          }
        ]
      }
    },
    {
      "name": "twice-included-reports-once",
      "description": "A file included twice reports each finding once, with the chain of its first inclusion; its include errors collapse too.",
      "resolver": "virtual",
      "entry": "{{ part.crv }}\n\n{{ part.crv }}\n",
      "files": {
        "part.crv": "Text.\n\n>quoted\n\n{{ gone.crv }}\n"
      },
      "expected": {
        "findings": [
          {
            "rule": "blockquote-marker-without-space",
            "file": "part.crv",
            "line": 3,
            "column": 1,
            "includedBy": [
              {
                "file": "doc.crv",
                "line": 1,
                "column": 1
              }
            ]
          },
          {
            "rule": "include-unresolved",
            "file": "part.crv",
            "line": 5,
            "column": 1,
            "includedBy": [
              {
                "file": "doc.crv",
                "line": 1,
                "column": 1
              }
            ]
          }
        ]
      }
    },
    {
      "name": "two-parents-report-once",
      "description": "A file reached through two parents reports once, with the chain of the first reach.",
      "resolver": "virtual",
      "entry": "{{ a.crv }}\n\n{{ b.crv }}\n",
      "files": {
        "a.crv": "{{ shared.crv }}\n",
        "b.crv": "{{ shared.crv }}\n",
        "shared.crv": ">quoted\n"
      },
      "expected": {
        "findings": [
          {
            "rule": "blockquote-marker-without-space",
            "file": "shared.crv",
            "line": 1,
            "column": 1,
            "includedBy": [
              {
                "file": "doc.crv",
                "line": 1,
                "column": 1
              },
              {
                "file": "a.crv",
                "line": 1,
                "column": 1
              }
            ]
          }
        ]
      }
    },
    {
      "name": "nested-code-include",
      "description": "A code include inside a Carve-mode include carries the whole chain.",
      "resolver": "virtual",
      "entry": "{{ part.crv }}\n",
      "files": {
        "part.crv": "Plans:\n\n{table}\n{{ data.csv @code:csv }}\n",
        "data.csv": "a,b\n\"x\n"
      },
      "expected": {
        "findings": [
          {
            "rule": "delimited-table-malformed",
            "file": "data.csv",
            "line": 2,
            "column": 1,
            "includedBy": [
              {
                "file": "doc.crv",
                "line": 1,
                "column": 1
              },
              {
                "file": "part.crv",
                "line": 4,
                "column": 1
              }
            ]
          }
        ]
      }
    },
    {
      "name": "region-selections-report-their-own-range",
      "description": "Two regions of one file each report their own range; a @shift on a range already reached adds nothing.",
      "resolver": "virtual",
      "entry": "{{ shared.crv @region:one }}\n\n{{ shared.crv @region:two }}\n\n{{ shared.crv @region:one @shift:1 }}\n",
      "files": {
        "shared.crv": "%% #region one\n>first\n%% #endregion\n\n%% #region two\n>second\n%% #endregion\n"
      },
      "expected": {
        "findings": [
          {
            "rule": "blockquote-marker-without-space",
            "file": "shared.crv",
            "line": 2,
            "column": 1,
            "includedBy": [
              {
                "file": "doc.crv",
                "line": 1,
                "column": 1
              }
            ]
          },
          {
            "rule": "blockquote-marker-without-space",
            "file": "shared.crv",
            "line": 6,
            "column": 1,
            "includedBy": [
              {
                "file": "doc.crv",
                "line": 3,
                "column": 1
              }
            ]
          }
        ]
      }
    },
    {
      "name": "lines-selection-reports-only-its-range",
      "description": "An @lines range is linted on its own and keeps the file coordinates.",
      "resolver": "virtual",
      "entry": "{{ part.crv @lines:5-5 }}\n",
      "files": {
        "part.crv": "Intro.\n\n>outside\n\n>inside\n"
      },
      "expected": {
        "findings": [
          {
            "rule": "blockquote-marker-without-space",
            "file": "part.crv",
            "line": 5,
            "column": 1,
            "includedBy": [
              {
                "file": "doc.crv",
                "line": 1,
                "column": 1
              }
            ]
          }
        ]
      }
    },
    {
      "name": "section-selection-reports-only-its-lines",
      "description": "A #section selection lints the whole file and keeps the findings on the selected lines.",
      "resolver": "virtual",
      "entry": "{{ part.crv #B }}\n",
      "files": {
        "part.crv": "# A\n\n>in-a\n\n# B\n\n>in-b\n"
      },
      "expected": {
        "findings": [
          {
            "rule": "blockquote-marker-without-space",
            "file": "part.crv",
            "line": 7,
            "column": 1,
            "includedBy": [
              {
                "file": "doc.crv",
                "line": 1,
                "column": 1
              }
            ]
          }
        ]
      }
    },
    {
      "name": "cycle",
      "description": "A cycle is reported at the directive that closes it, in the file that wrote it.",
      "resolver": "virtual",
      "entry": "{{ a.crv }}\n",
      "files": {
        "a.crv": "Text.\n\n{{ b.crv }}\n",
        "b.crv": "{{ a.crv }}\n"
      },
      "expected": {
        "findings": [
          {
            "rule": "include-cycle",
            "file": "b.crv",
            "line": 1,
            "column": 1,
            "includedBy": [
              {
                "file": "doc.crv",
                "line": 1,
                "column": 1
              },
              {
                "file": "a.crv",
                "line": 3,
                "column": 1
              }
            ]
          }
        ]
      }
    },
    {
      "name": "missing-file",
      "description": "A missing target is reported at its directive in the top-level document, with no chain.",
      "resolver": "virtual",
      "entry": "Intro.\n\n{{ missing.crv }}\n",
      "files": {},
      "expected": {
        "findings": [
          {
            "rule": "include-unresolved",
            "file": "doc.crv",
            "line": 3,
            "column": 1
          }
        ]
      }
    },
    {
      "name": "mid-line-directive",
      "description": "A directive that is not first on its line is reported at its own column (carve-js#3254).",
      "resolver": "virtual",
      "entry": "Some text {{ missing.crv }} more text.\n",
      "files": {},
      "expected": {
        "findings": [
          {
            "rule": "include-unresolved",
            "file": "doc.crv",
            "line": 1,
            "column": 11
          }
        ]
      }
    },
    {
      "name": "mid-line-directive-in-a-chain",
      "description": "A mid-line directive in an included file, reached through a mid-line directive, reports both directive columns.",
      "resolver": "virtual",
      "entry": "Intro {{ part.crv }} end.\n",
      "files": {
        "part.crv": "a {{ gone.crv }} b\n"
      },
      "expected": {
        "findings": [
          {
            "rule": "include-unresolved",
            "file": "part.crv",
            "line": 1,
            "column": 3,
            "includedBy": [
              {
                "file": "doc.crv",
                "line": 1,
                "column": 7
              }
            ]
          }
        ]
      }
    },
    {
      "name": "invalid-region",
      "description": "A missing region is reported at the directive.",
      "resolver": "virtual",
      "entry": "{{ part.crv @region:nope }}\n",
      "files": {
        "part.crv": ">never linted\n"
      },
      "expected": {
        "findings": [
          {
            "rule": "include-region-invalid",
            "file": "doc.crv",
            "line": 1,
            "column": 1
          }
        ]
      }
    },
    {
      "name": "selection-conflict",
      "description": "Two selections on one directive are reported at the directive.",
      "resolver": "virtual",
      "entry": "{{ part.crv #a @lines:1-2 }}\n",
      "files": {
        "part.crv": "# A\n\n>never linted\n"
      },
      "expected": {
        "findings": [
          {
            "rule": "include-selection-conflict",
            "file": "doc.crv",
            "line": 1,
            "column": 1
          }
        ]
      }
    },
    {
      "name": "no-resolver-expands-nothing",
      "description": "Without a root or resolver lint reads no include target and reports nothing about one.",
      "resolver": "none",
      "entry": "{{ part.crv }}\n\n{{ missing.crv }}\n",
      "files": {
        "part.crv": ">quoted\n"
      },
      "expected": {
        "findings": []
      }
    }
  ]
}
