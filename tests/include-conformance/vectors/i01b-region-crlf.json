{
  "name": "i01b-region-crlf",
  "description": "CRLF marker lines are recognized and the selected lines keep their content.",
  "rules": [
    "I1b"
  ],
  "mode": "virtual",
  "resolver": "virtual",
  "entry": "{{ child @region:demo }}",
  "files": {
    "child": "Before.\r\n%% #region demo\r\nBody.\r\n%% #endregion demo\r\nAfter.\r\n"
  },
  "expected": {
    "html": "<p>Body.</p>",
    "fmt": "{{ child @region:demo }}\n",
    "warnings": [],
    "dependencies": [
      {
        "id": "child",
        "resolved": true
      }
    ]
  }
}
