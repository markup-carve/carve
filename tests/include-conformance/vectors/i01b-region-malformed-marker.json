{
  "name": "i01b-region-malformed-marker",
  "description": "Content after a marker name makes region selection invalid.",
  "rules": [
    "I1b"
  ],
  "mode": "virtual",
  "resolver": "virtual",
  "entry": "{{ child @region:demo }}",
  "files": {
    "child": "// #region demo extra\nBody.\n// #endregion demo"
  },
  "expected": {
    "html": "<p>{{ child <span class=\"mention\"><strong>@region</strong></span>:demo }}</p>",
    "fmt": "{{ child @region:demo }}\n",
    "warnings": [
      {
        "rule": "include-region-invalid"
      }
    ],
    "dependencies": [
      {
        "id": "child",
        "resolved": true
      }
    ]
  }
}
