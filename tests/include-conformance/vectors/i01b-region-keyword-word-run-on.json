{
  "name": "i01b-region-keyword-word-run-on",
  "description": "A marker keyword followed by a word character is ordinary content.",
  "rules": [
    "I1b"
  ],
  "mode": "virtual",
  "resolver": "virtual",
  "entry": "{{ child @region:demo }}",
  "files": {
    "child": "// #regional note\n// #endregions\n// #region demo\nBody.\n// #endregion demo"
  },
  "expected": {
    "html": "<p>Body.</p>",
    "fmt": "{{ child @region:demo }}\n",
    "warnings": [],
    "dependencies": [
      {
        "id": "child",
        "resolved": true
      }
    ]
  }
}
