{
  "name": "i05-footnote-rename",
  "description": "Duplicate footnote labels across includes: first wins, later renamed, each ref stays with its definition.",
  "rules": [
    "I5"
  ],
  "mode": "virtual",
  "resolver": "virtual",
  "entry": "{{ a }}\n\n{{ b }}",
  "files": {
    "a": "First[^a].\n\n[^a]: one",
    "b": "Second[^a].\n\n[^a]: two"
  },
  "expected": {
    "html": "<p>First<a id=\"fnref1\" href=\"#fn1\" role=\"doc-noteref\"><sup>1</sup></a>.</p>\n<p>Second<a id=\"fnref2\" href=\"#fn2\" role=\"doc-noteref\"><sup>2</sup></a>.</p>\n<section role=\"doc-endnotes\">\n  <hr>\n  <ol>\n    <li id=\"fn1\">\n      <p>one<a href=\"#fnref1\" role=\"doc-backlink\">↩</a></p>\n    </li>\n    <li id=\"fn2\">\n      <p>two<a href=\"#fnref2\" role=\"doc-backlink\">↩</a></p>\n    </li>\n  </ol>\n</section>",
    "fmt": "{{ a }}\n\n{{ b }}\n",
    "warnings": [
      {
        "rule": "include-footnote-rename",
        "file": "b"
      }
    ],
    "dependencies": [
      {
        "id": "a",
        "resolved": true
      },
      {
        "id": "b",
        "resolved": true
      }
    ]
  }
}
