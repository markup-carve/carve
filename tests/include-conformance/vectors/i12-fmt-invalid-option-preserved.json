    "html": "<p>{{ chapter.crv <span class=\"mention\"><strong>@bogus</strong></span>:1 }}</p>",
    "fmt": "{{ chapter.crv @bogus:1 }}\n",
    "warnings": [],
    "dependencies": []
  }
}
