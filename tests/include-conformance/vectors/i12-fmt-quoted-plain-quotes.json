{
  "name": "i12-fmt-quoted-plain-quotes",
  "description": "A quoted path formats with PLAIN quotes so any engine reads it back the same.",
  "rules": [
    "I12",
    "quoted-path"
  ],
  "mode": "virtual",
  "resolver": "none",
  "entry": "{{ \"my chapter.crv\" }}",
  "files": {},
  "expected": {
    "html": "<p>{{ “my chapter.crv” }}</p>",
    "fmt": "{{ \"my chapter.crv\" }}\n",
    "warnings": [],
    "dependencies": []
  }
}
