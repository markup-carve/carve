{
  "name": "i01-inverted-line-range",
  "description": "A reversed @lines range warns as include-lines-invalid, stays literal, and retains its resolved dependency.",
  "rules": [
    "I1"
  ],
  "mode": "virtual",
  "resolver": "virtual",
  "entry": "{{ child @lines:3-1 }}",
  "files": {
    "child": "a\nb\nc"
  },
  "expected": {
    "html": "<p>{{ child @lines:3-1 }}</p>",
    "fmt": "{{ child @lines:3-1 }}\n",
    "warnings": [
      {
        "rule": "include-lines-invalid"
      }
    ],
    "dependencies": [
      {
        "id": "child",
        "resolved": true
      }
    ]
  }
}
