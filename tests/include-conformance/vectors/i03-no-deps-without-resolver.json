{
  "name": "i03-no-deps-without-resolver",
  "description": "A directive with no resolver reports no dependencies at all.",
  "rules": [
    "I3",
    "I11"
  ],
  "mode": "virtual",
  "resolver": "none",
  "entry": "{{ child }}",
  "files": {},
  "expected": {
    "html": "<p>{{ child }}</p>",
    "fmt": "{{ child }}\n",
    "warnings": [],
    "dependencies": []
  }
}
