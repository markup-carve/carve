{
  "name": "i01c-code-table-csv",
  "description": "The carve#3335 example: `{table}` above a csv code include makes the table an authored `{table}` csv fence makes.",
  "rules": [
    "I1c"
  ],
  "mode": "virtual",
  "resolver": "virtual",
  "entry": "{table}\n{{ data/plans.csv @code:csv }}",
  "files": {
    "data/plans.csv": "Plan,Seats,Price\nStarter,1,\"$0\"\nTeam,10,\"$49, billed yearly\"\n"
  },
  "expected": {
    "html": "<table>\n  <thead>\n    <tr><th scope=\"col\">Plan</th><th scope=\"col\">Seats</th><th scope=\"col\">Price</th></tr>\n  </thead>\n  <tbody>\n    <tr><td>Starter</td><td>1</td><td>$0</td></tr>\n    <tr><td>Team</td><td>10</td><td>$49, billed yearly</td></tr>\n  </tbody>\n</table>",
    "fmt": "{table}\n{{ data/plans.csv @code:csv }}\n",
    "warnings": [],
    "dependencies": [
      {
        "id": "data/plans.csv",
        "resolved": true
      }
    ]
  }
}
