{
  "name": "i01c-code-table-span",
  "description": "A CSV table made from a code include keeps the source span.",
  "rules": [
    "I1c"
  ],
  "mode": "virtual",
  "resolver": "virtual",
  "entry": "{table}\n{{ d.csv @code:csv }}\n",
  "files": {
    "d.csv": "a,b\n1,2\n"
  },
  "checkPositions": true,
  "expected": {
    "html": "<table>\n  <thead>\n    <tr><th scope=\"col\">a</th><th scope=\"col\">b</th></tr>\n  </thead>\n  <tbody>\n    <tr><td>1</td><td>2</td></tr>\n  </tbody>\n</table>",
    "fmt": "{table}\n{{ d.csv @code:csv }}\n",
    "positions": [
      {
        "type": "table",
        "pos": {
          "startLine": 1,
          "startColumn": 1,
          "endLine": 2,
          "endColumn": 4,
          "startOffset": 0,
          "endOffset": 7,
          "file": "d.csv"
        }
      },
      {
        "type": "table_head"
      },
      {
        "type": "table_row"
      },
      {
        "type": "table_cell"
      },
      {
        "type": "cell_paragraph"
      },
      {
        "type": "text"
      },
      {
        "type": "table_cell"
      },
      {
        "type": "cell_paragraph"
      },
      {
        "type": "text"
      },
      {
        "type": "table_body"
      },
      {
        "type": "table_row"
      },
      {
        "type": "table_cell"
      },
      {
        "type": "cell_paragraph"
      },
      {
        "type": "text"
      },
      {
        "type": "table_cell"
      },
      {
        "type": "cell_paragraph"
      },
      {
        "type": "text"
      },
      {
        "type": "table_column"
      },
      {
        "type": "table_column"
      }
    ],
    "warnings": [],
    "dependencies": [
      {
        "id": "d.csv",
        "resolved": true
      }
    ]
  }
}
