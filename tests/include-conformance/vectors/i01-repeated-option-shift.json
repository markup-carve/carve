{
  "name": "i01-repeated-option-shift",
  "description": "Two shifts are an error, not \"the last one wins\".",
  "rules": [
    "I1",
    "I7"
  ],
  "mode": "virtual",
  "resolver": "virtual",
  "entry": "{{ a.js @shift:1 @shift:2 @code }}",
  "files": {
    "a.js": "one()\ntwo()\nthree()\n"
  },
  "expected": {
    "html": "<p>{{ a.js <span class=\"mention\"><strong>@shift</strong></span>:1 <span class=\"mention\"><strong>@shift</strong></span>:2 <span class=\"mention\"><strong>@code</strong></span> }}</p>",
    "fmt": "{{ a.js @shift:1 @shift:2 @code }}\n",
    "warnings": [
      {
        "rule": "include-duplicate-option"
      }
    ],
    "dependencies": []
  }
}
