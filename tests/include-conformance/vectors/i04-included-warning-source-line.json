{
  "name": "i04-included-warning-source-line",
  "description": "An unresolved directive on child line 3 names the child and that line, not the parent include site.",
  "rules": [
    "I4"
  ],
  "mode": "virtual",
  "resolver": "virtual",
  "entry": "{{ child.crv }}",
  "files": {
    "child.crv": "First.\n\n{{ missing.crv }}"
  },
  "options": {
    "sourcePath": "book.crv"
  },
  "checkWarningLocations": true,
  "expected": {
    "html": "<p>First.</p>\n<p>{{ missing.crv }}</p>",
    "fmt": "{{ child.crv }}\n",
    "warnings": [
      {
        "rule": "include-unresolved",
        "file": "child.crv"
      }
    ],
    "warningLocations": [
      {
        "rule": "include-unresolved",
        "file": "child.crv",
        "line": 3
      }
    ],
    "dependencies": [
      {
        "id": "child.crv",
        "resolved": true
      },
      {
        "id": "missing.crv",
        "resolved": false
      }
    ]
  }
}
