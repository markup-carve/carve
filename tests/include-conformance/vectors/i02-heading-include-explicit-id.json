{
  "name": "i02-heading-include-explicit-id",
  "description": "An explicit heading id wins over the post-expansion slug when a directive fills the heading text.",
  "rules": [
    "I2",
    "I9a",
    "heading-include"
  ],
  "mode": "virtual",
  "resolver": "virtual",
  "entry": "{#custom}\n# {{ title.crv }}",
  "files": {
    "title.crv": "My Title"
  },
  "expected": {
    "html": "<section id=\"custom\">\n  <h1>My Title</h1>\n</section>",
    "fmt": "{#custom}\n# {{ title.crv }}\n",
    "warnings": [],
    "dependencies": [
      {
        "id": "title.crv",
        "resolved": true
      }
    ]
  }
}
