{
  "name": "i01b-region-empty",
  "description": "An empty region selects an empty source.",
  "rules": [
    "I1b"
  ],
  "mode": "virtual",
  "resolver": "virtual",
  "entry": "{{ child @region:demo }}",
  "files": {
    "child": "%% #region demo\n%% #endregion demo"
  },
  "expected": {
    "html": "",
    "fmt": "{{ child @region:demo }}\n",
    "warnings": [],
    "dependencies": [
      {
        "id": "child",
        "resolved": true
      }
    ]
  }
}
