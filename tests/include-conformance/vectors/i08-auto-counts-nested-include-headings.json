{
  "name": "i08-auto-counts-nested-include-headings",
  "description": "auto counts headings a child contributes only through a nested include.",
  "rules": [
    "I8"
  ],
  "mode": "virtual",
  "resolver": "virtual",
  "entry": "# One\n\n## Two\n\n{{ child @shift:auto }}",
  "files": {
    "child": "{{ grand }}",
    "grand": "# GrandTop\n\n## GrandSub"
  },
  "expected": {
    "html": "<section id=\"One\">\n  <h1>One</h1>\n  <section id=\"Two\">\n    <h2>Two</h2>\n    <section id=\"GrandTop\">\n      <h3>GrandTop</h3>\n      <section id=\"GrandSub\">\n        <h4>GrandSub</h4>\n      </section>\n    </section>\n  </section>\n</section>",
    "fmt": "# One\n\n## Two\n\n{{ child @shift:auto }}\n",
    "warnings": [],
    "dependencies": [
      {
        "id": "child",
        "resolved": true
      },
      {
        "id": "grand",
        "resolved": true
      }
    ]
  }
}
