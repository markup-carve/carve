{
  "name": "i13-no-side-effect-cycle",
  "description": "A cyclic include reserves nothing.",
  "rules": [
    "I13"
  ],
  "mode": "virtual",
  "resolver": "virtual",
  "entry": "Text {{ a }} text.\n\n{{ later }}",
  "files": {
    "later": "{#dup}\n# Later\n\nSee [^note].\n\n[^note]: Later note.",
    "a": "{#dup}\n# A\n\n{{ a }}"
  },
  "expected": {
    "html": "<p>Text {{ a }} text.</p>\n<section id=\"dup\">\n  <h1>Later</h1>\n  <p>See <a id=\"fnref1\" href=\"#fn1\" role=\"doc-noteref\"><sup>1</sup></a>.</p>\n</section>\n<section role=\"doc-endnotes\">\n  <hr>\n  <ol>\n    <li id=\"fn1\">\n      <p>Later note.<a href=\"#fnref1\" role=\"doc-backlink\">↩</a></p>\n    </li>\n  </ol>\n</section>",
    "fmt": "Text {{ a }} text\\.\n\n{{ later }}\n",
    "warnings": [
      {
        "rule": "include-cycle",
        "file": "a"
      },
      {
        "rule": "include-block-in-inline"
      }
    ],
    "dependencies": [
      {
        "id": "a",
        "resolved": true
      },
      {
        "id": "later",
        "resolved": true
      }
    ]
  }
}
