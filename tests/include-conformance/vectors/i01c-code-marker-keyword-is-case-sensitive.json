{
  "name": "i01c-code-marker-keyword-is-case-sensitive",
  "description": "A `// #Region` keyword is not a marker in a code include either.",
  "rules": [
    "I1b",
    "I1c"
  ],
  "mode": "virtual",
  "resolver": "virtual",
  "entry": "{{ a.js @region:demo @code:js }}",
  "files": {
    "a.js": "// #Region demo\nx()\n// #EndRegion demo\n"
  },
  "expected": {
    "html": "<p>{{ a.js @region:demo @code:js }}</p>",
    "fmt": "{{ a.js @region:demo @code:js }}\n",
    "warnings": [
      {
        "rule": "include-region-invalid"
      }
    ],
    "dependencies": [
      {
        "id": "a.js",
        "resolved": true
      }
    ]
  }
}
