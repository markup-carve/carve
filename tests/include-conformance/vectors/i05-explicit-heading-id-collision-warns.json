{
  "name": "i05-explicit-heading-id-collision-warns",
  "description": "An explicit id collision across files is renamed AND reported: it is a cross-reference target.",
  "rules": [
    "I5"
  ],
  "mode": "virtual",
  "resolver": "virtual",
  "entry": "{{ a.crv }}\n\n{{ b.crv }}\n",
  "files": {
    "a.crv": "{#intro}\n# A\n\nFirst.\n",
    "b.crv": "{#intro}\n# B\n\nSecond.\n"
  },
  "expected": {
    "html": "<section id=\"intro\">\n  <h1>A</h1>\n  <p>First.</p>\n</section>\n<section id=\"intro-2\">\n  <h1>B</h1>\n  <p>Second.</p>\n</section>",
    "fmt": "{{ a.crv }}\n\n{{ b.crv }}\n",
    "warnings": [
      {
        "rule": "include-heading-id-rename",
        "file": "b.crv"
      }
    ],
    "dependencies": [
      {
        "id": "a.crv",
        "resolved": true
      },
      {
        "id": "b.crv",
        "resolved": true
      }
    ]
  }
}
