{
  "name": "i01c-code-region-blank-last-line",
  "description": "Regions ending in a blank line, holding one blank line, or empty keep distinct spans.",
  "rules": [
    "I1b",
    "I1c"
  ],
  "mode": "virtual",
  "resolver": "virtual",
  "entry": "{{ r.js @region:a @code }}\n\n{{ r.js @region:b @code }}\n\n{{ r.js @region:c @code }}\n",
  "files": {
    "r.js": "// #region a\nx\n\n// #endregion a\n// #region b\n\n// #endregion b\n// #region c\n// #endregion c\n"
  },
  "checkPositions": true,
  "expected": {
    "html": "<pre><code>x\n\n</code></pre>\n<pre><code>\n</code></pre>\n<pre><code></code></pre>",
    "fmt": "{{ r.js @region:a @code }}\n\n{{ r.js @region:b @code }}\n\n{{ r.js @region:c @code }}\n",
    "positions": [
      {
