{
  "name": "i08-auto-assembled-under-numeric-parent",
  "description": "A nested auto resolves against the document as assembled under a numeric parent shift.",
  "rules": [
    "I8"
  ],
  "mode": "virtual",
  "resolver": "virtual",
  "entry": "{{ child @shift:1 }}",
  "files": {
    "child": "# ChildTop\n\n{{ grand @shift:auto }}",
    "grand": "# GrandTop"
  },
  "expected": {
    "html": "<section id=\"ChildTop\">\n  <h2>ChildTop</h2>\n  <section id=\"GrandTop\">\n    <h3>GrandTop</h3>\n  </section>\n</section>",
    "fmt": "{{ child @shift:1 }}\n",
    "warnings": [],
    "dependencies": [
      {
        "id": "child",
        "resolved": true
      },
      {
        "id": "grand",
        "resolved": true
      }
    ]
  }
}
