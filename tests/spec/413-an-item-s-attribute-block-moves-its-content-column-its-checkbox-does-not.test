An item's attribute block moves its content column; its checkbox does not

```
-{#k} [x] bare
  # inside
.
<ul>
  <li id="k"><input type="checkbox" checked disabled aria-label="bare"> bare
    <h1 id="inside">inside</h1>
  </li>
</ul>
```

```
-{#k} [x] old
      # outside
.
<ul>
  <li id="k"><input type="checkbox" checked disabled aria-label="old # outside"> old
# outside</li>
</ul>
```

```
- [x] a
  # h
.
<ul>
  <li><input type="checkbox" checked disabled aria-label="a"> a
    <h1 id="h">h</h1>
  </li>
</ul>
```

```
-{#k} a
  # h
.
<ul>
  <li id="k">a
    <h1 id="h">h</h1>
  </li>
</ul>
```

```
1.{#k} a
   # h
.
<ol>
  <li id="k">a
    <h1 id="h">h</h1>
  </li>
</ol>
```

```
- outer
  -{#k} [x] inner

  after
.
<ul>
  <li><p>outer</p>
    <ul>
      <li id="k"><input type="checkbox" checked disabled aria-label="inner"> inner</li>
    </ul>
    <p>after</p>
  </li>
</ul>
```

```
-{.x} a
  # one
-{.averylongclass} b
  # two
.
<ul>
  <li class="x">a
    <h1 id="one">one</h1>
  </li>
  <li class="averylongclass">b
    <h1 id="two">two</h1>
  </li>
</ul>
```

```
-{.x1} a
       # h
.
<ul>
  <li class="x1">a
# h</li>
</ul>
```

```
-{title="😀"} [x] a
  # h
.
<ul>
  <li title="😀"><input type="checkbox" checked disabled aria-label="a"> a
    <h1 id="h">h</h1>
  </li>
</ul>
```

```
-{.outer} parent
  - child
.
<ul>
  <li class="outer">parent
    <ul>
      <li>child</li>
    </ul>
  </li>
</ul>
```
