An explicitly delimited row of blank cells is a table

```
| |
.
<table>
  <tbody>
    <tr><td></td></tr>
  </tbody>
</table>
```

```
||
.
<table>
  <tbody>
    <tr><td></td></tr>
  </tbody>
</table>
```

```
|||
.
<table>
  <tbody>
    <tr><td></td><td></td></tr>
  </tbody>
</table>
```

```
| | |
.
<table>
  <tbody>
    <tr><td></td><td></td></tr>
  </tbody>
</table>
```

```
||||
.
<table>
  <tbody>
    <tr><td></td><td></td><td></td></tr>
  </tbody>
</table>
```

```
|= |
.
<table>
  <thead>
    <tr><th scope="col"></th></tr>
  </thead>
</table>
```

```
|=|
.
<table>
  <tbody>
    <tr><td>=</td></tr>
  </tbody>
</table>
```

```
|{>} |
.
<table>
  <tbody>
    <tr><td style="text-align: right;"></td></tr>
  </tbody>
</table>
```

```
|>|
.
<table>
  <tbody>
    <tr><td>&gt;</td></tr>
  </tbody>
</table>
```

```
|={~ .x} |
.
<table>
  <thead>
    <tr><th scope="col" class="x" style="text-align: center;"></th></tr>
  </thead>
</table>
```

```
|{#x} |
.
<table>
  <tbody>
    <tr><td id="x"></td></tr>
  </tbody>
</table>
```

```
|{#x}|
.
<table>
  <tbody>
    <tr><td>{<span class="tag"><strong>#x</strong></span>}</td></tr>
  </tbody>
</table>
```

```
| |{.row}
.
<table>
  <tbody>
    <tr class="row"><td></td></tr>
  </tbody>
</table>
```

```
| |{bad!!}
.
<p>| |{bad!!}</p>
```

```
| {bad!!} |
.
<table>
  <tbody>
    <tr><td>{bad!!}</td></tr>
  </tbody>
</table>
```

```
|
.
<p>|</p>
```

```
| a | b
.
<p>| a | b</p>
```

```
| \| |
.
<table>
  <tbody>
    <tr><td>|</td></tr>
  </tbody>
</table>
```

```
\| |
.
<p>| |</p>
```

```
| `|` |
.
<table>
  <tbody>
    <tr><td><code>|</code></td></tr>
  </tbody>
</table>
```

```
| `a|b` | |
.
<table>
  <tbody>
    <tr><td><code>a|b</code></td><td></td></tr>
  </tbody>
</table>
```

```
|	|
.
<table>
  <tbody>
    <tr><td>	</td></tr>
  </tbody>
</table>
```

```
| |   
.
<table>
  <tbody>
    <tr><td></td></tr>
  </tbody>
</table>
```

```
text
| |
.
<p>text</p>
<table>
  <tbody>
    <tr><td></td></tr>
  </tbody>
</table>
```

```
text
|||
.
<p>text</p>
<table>
  <tbody>
    <tr><td></td><td></td></tr>
  </tbody>
</table>
```

```
| |
| a |
| |
.
<table>
  <tbody>
    <tr><td></td></tr>
    <tr><td>a</td></tr>
    <tr><td></td></tr>
  </tbody>
</table>
```

```
| | |
|||
| | |
.
<table>
  <tbody>
    <tr><td></td><td></td></tr>
    <tr><td></td><td></td></tr>
    <tr><td></td><td></td></tr>
  </tbody>
</table>
```

```
> text
> | |
> | |
.
<blockquote>
  <p>text</p>
  <table>
    <tbody>
      <tr><td></td></tr>
      <tr><td></td></tr>
    </tbody>
  </table>
</blockquote>
```

```
- | |
- |||
.
<ul>
  <li>
    <table>
      <tbody>
        <tr><td></td></tr>
      </tbody>
    </table>
  </li>
  <li>
    <table>
      <tbody>
        <tr><td></td><td></td></tr>
      </tbody>
    </table>
  </li>
</ul>
```

```
| |
^ A caption
.
<table>
  <caption>A caption</caption>
  <tbody>
    <tr><td></td></tr>
  </tbody>
</table>
```

```
|= |= |
| a | b |
|= |= |
.
<table>
  <thead>
    <tr><th scope="col"></th><th scope="col"></th></tr>
  </thead>
  <tbody>
    <tr><td>a</td><td>b</td></tr>
    <tr><th scope="row"></th><th scope="row"></th></tr>
  </tbody>
</table>
```

```
|= |= |
| a | b |
.
<table>
  <thead>
    <tr><th scope="col"></th><th scope="col"></th></tr>
  </thead>
  <tbody>
    <tr><td>a</td><td>b</td></tr>
  </tbody>
</table>
```

```
| | |
+ x | y |
.
<table>
  <tbody>
    <tr><td>x</td><td>y</td></tr>
  </tbody>
</table>
```

```
| |
+ |
| |
.
<table>
  <tbody>
    <tr><td></td></tr>
    <tr><td></td></tr>
  </tbody>
</table>
```

```
+ | |
.
<p>+ | |</p>
```

```
| | < |
| ^ | ^ |
.
<table>
  <tbody>
    <tr><td rowspan="2" colspan="2"></td></tr>
    <tr></tr>
  </tbody>
</table>
```
