A floating attribute does not widen a list item's content column

```
-{#k} {#h}
  # h
.
<ul>
  <li id="k">
    <h1 id="h">h</h1>
  </li>
</ul>
```

```
1.{#k} {#h}
   # h
.
<ol>
  <li id="k">
    <h1 id="h">h</h1>
  </li>
</ol>
```

```
-{#k} [x] {#h}
  # h
.
<ul>
  <li id="k"><input type="checkbox" checked disabled> 
    <h1 id="h">h</h1>
  </li>
</ul>
```

```
-{#k} {#h}
 # h
.
<ul>
  <li id="k"></li>
</ul>
<p># h</p>
```

```
-{#k} text
 # h
.
<ul>
  <li id="k">text
# h</li>
</ul>
```

```
1.{#k} {#h}
  # h
.
<ol>
  <li id="k"></li>
</ol>
<p># h</p>
```

```
-{#k} [x] {#h}
 # h
.
<ul>
  <li id="k"><input type="checkbox" checked disabled> </li>
</ul>
<p># h</p>
```
