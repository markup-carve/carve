{
  "version": 1,
  "rule": "table-shaped-paragraph",
  "vectors": [
    {
      "name": "body-row-missing-end",
      "description": "body row missing end.",
      "source": "|= A |= B |\n| 1 | 2\n",
      "expected": {
        "findings": [
          {
            "line": 2,
            "column": 1,
            "includes": [
              "table"
            ]
          }
        ]
      }
    },
    {
      "name": "closed-row",
      "description": "closed row.",
      "source": "|= A |= B |\n| 1 | 2 |\n",
      "expected": {
        "findings": []
      }
    },
    {
      "name": "header-row-missing-end",
      "description": "An unclosed header-shaped row remains paragraph text.",
      "source": "|= A |= B\n| 1 | 2 |\n",
      "expected": {
        "findings": [
          {
            "line": 1,
            "column": 1,
            "includes": [
              "table"
            ]
          }
        ]
      }
    },
    {
      "name": "all-rows-missing-end",
      "description": "The first unclosed row is reported once.",
      "source": "|= A |= B\n| 1 | 2\n",
      "expected": {
        "findings": [
          {
            "line": 1,
            "column": 1,
            "includes": [
              "table"
            ]
          }
        ]
      }
    },
    {
      "name": "ordinary-pipe-prose",
      "description": "A prose line containing a pipe is not table-shaped.",
      "source": "A | B\n",
      "expected": {
        "findings": []
      }
    }
  ]
}
