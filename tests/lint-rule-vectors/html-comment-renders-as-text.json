{
  "version": 1,
  "rule": "html-comment-renders-as-text",
  "vectors": [
    {
      "name": "comment-line",
      "description": "comment line.",
      "source": "<!-- TODO secret -->\n",
      "expected": {
        "findings": [
          {
            "line": 1,
            "column": 1,
            "includes": [
              "%%",
              "%%%"
            ]
          }
        ]
      }
    },
    {
      "name": "comment-across-lines",
      "description": "comment across lines.",
      "source": "a <!-- x\ny --> b\n",
      "expected": {
        "findings": [
          {
            "line": 1,
            "column": 3,
            "includes": [
              "%%",
              "%%%"
            ]
          }
        ]
      }
    },
    {
      "name": "code-span",
      "description": "code span.",
      "source": "`<!-- x -->`\n",
      "expected": {
        "findings": []
      }
    },
    {
      "name": "unclosed",
      "description": "unclosed.",
      "source": "a <!-- x\n",
      "expected": {
        "findings": []
      }
    },
    {
      "name": "carve-comment",
      "description": "carve comment.",
      "source": "%% TODO secret\n",
      "expected": {
        "findings": []
      }
    }
  ]
}
