{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "carve",
  "scopeName": "source.carve",
  "fileTypes": ["crv"],
  "aliases": ["crv"],
  "patterns": [
    { "include": "#frontmatter" },
    { "include": "#fenced_code" },
    { "include": "#heading" },
    { "include": "#hr" },
    { "include": "#block_comment" },
    { "include": "#line_comment" },
    { "include": "#admonition" },
    { "include": "#blockquote" },
    { "include": "#abbreviation" },
    { "include": "#caption" },
    { "include": "#table_row" },
    { "include": "#multiline_cell" },
    { "include": "#task_item" },
    { "include": "#list_continuation" },
    { "include": "#list_item" },
    { "include": "#numbered_item" },
    { "include": "#inline" }
  ],
  "repository": {
    "frontmatter": {
      "begin": "\\A---\\s*$",
      "end": "^---\\s*$",
      "name": "meta.frontmatter.carve",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.frontmatter.carve" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.frontmatter.carve" }
      },
      "patterns": [
        {
          "match": "^([A-Za-z_][\\w-]*)\\s*(:)",
          "captures": {
            "1": { "name": "entity.name.tag.yaml.carve" },
            "2": { "name": "punctuation.separator.key-value.yaml.carve" }
          }
        }
      ]
    },
    "fenced_code": {
      "begin": "^(\\s*)(`{3,}|~{3,})\\s*([a-zA-Z0-9_-]*)\\s*$",
      "beginCaptures": {
        "2": { "name": "punctuation.definition.fenced.carve" },
        "3": { "name": "fenced_code.block.language.carve" }
      },
      "end": "^\\1\\2\\s*$",
      "endCaptures": {
        "0": { "name": "punctuation.definition.fenced.carve" }
      },
      "name": "markup.fenced_code.block.carve",
      "contentName": "markup.raw.code.carve"
    },
    "heading": {
      "match": "^(#{1,6})\\s+(.*?)\\s*$",
      "captures": {
        "1": { "name": "punctuation.definition.heading.carve" },
        "2": { "name": "entity.name.section.carve" }
      },
      "name": "markup.heading.carve"
    },
    "hr": {
      "match": "^\\s*-{3,}\\s*$",
      "name": "meta.separator.thematic-break.carve"
    },
    "block_comment": {
      "begin": "^\\s*%%%\\s*$",
      "end": "^\\s*%%%\\s*$",
      "name": "comment.block.carve"
    },
    "line_comment": {
      "match": "^\\s*%%(?!%).*$",
      "name": "comment.line.percent.carve"
    },
    "trailing_comment": {
      "match": "(?<=[ \\t])%%.*$",
      "name": "comment.line.percent.carve"
    },
    "admonition": {
      "match": "^(:::)\\s*([a-zA-Z][\\w-]*)?\\s*(.*)$",
      "captures": {
        "1": { "name": "punctuation.definition.admonition.carve" },
        "2": { "name": "entity.name.tag.admonition.carve" },
        "3": { "name": "string.unquoted.admonition.title.carve" }
      },
      "name": "meta.admonition.carve"
    },
    "blockquote": {
      "match": "^(>)\\s*(.*)$",
      "captures": {
        "1": { "name": "punctuation.definition.quote.carve" },
        "2": { "name": "markup.quote.carve" }
      },
      "name": "markup.quote.carve"
    },
    "caption": {
      "match": "^(\\^)\\s+(.*)$",
      "captures": {
        "1": { "name": "punctuation.definition.caption.carve" },
        "2": { "name": "markup.caption.carve" }
      },
      "name": "meta.caption.carve"
    },
    "abbreviation": {
      "match": "^(\\*)(\\[)([A-Z][A-Z0-9]*)(\\])(:)\\s+(.*)$",
      "captures": {
        "1": { "name": "punctuation.definition.abbreviation.carve" },
        "2": { "name": "punctuation.definition.abbreviation.carve" },
        "3": { "name": "entity.name.abbreviation.carve" },
        "4": { "name": "punctuation.definition.abbreviation.carve" },
        "5": { "name": "punctuation.separator.carve" },
        "6": { "name": "string.unquoted.abbreviation.carve" }
      },
      "name": "meta.abbreviation.carve"
    },
    "table_row": {
      "begin": "^(?=\\|)",
      "end": "$",
      "patterns": [
        {
          "match": "\\|=",
          "name": "keyword.operator.table.header.carve"
        },
        {
          "match": "(?<=\\|)\\s*(\\^)\\s*(?=\\|)",
          "captures": {
            "1": { "name": "keyword.operator.table.rowspan.carve" }
          }
        },
        {
          "match": "(?<=\\|)\\s*(<)\\s*(?=\\|)",
          "captures": {
            "1": { "name": "keyword.operator.table.colspan.carve" }
          }
        },
        {
          "match": "\\|",
          "name": "punctuation.separator.table.carve"
        },
        { "include": "#inline" }
      ]
    },
    "multiline_cell": {
      "match": "^(\\+)(.*)$",
      "captures": {
        "1": { "name": "keyword.operator.table.continuation.carve" }
      }
    },
    "task_item": {
      "match": "^(\\s*)([-*])\\s+(\\[)([ xX])(\\])\\s+",
      "captures": {
        "2": { "name": "punctuation.definition.list.carve" },
        "3": { "name": "punctuation.definition.checkbox.carve" },
        "4": { "name": "constant.language.checkbox.carve" },
        "5": { "name": "punctuation.definition.checkbox.carve" }
      }
    },
    "list_continuation": {
      "comment": "A lone `+` at the list-marker column is the list-continuation marker (not a bullet -- `+` is never a bullet in Carve); it attaches the following flush-left block to the item.",
      "match": "^(\\s*)(\\+)(\\s*)$",
      "captures": {
        "2": { "name": "punctuation.definition.list.continuation.carve" }
      }
    },
    "list_item": {
      "match": "^(\\s*)([-*])(\\s+)",
      "captures": {
        "2": { "name": "punctuation.definition.list.unnumbered.carve" }
      }
    },
    "numbered_item": {
      "match": "^(\\s*)(\\d+\\.)(\\s+)",
      "captures": {
        "2": { "name": "punctuation.definition.list.numbered.carve" }
      }
    },
    "inline": {
      "patterns": [
        { "include": "#code_inline" },
        { "include": "#trailing_comment" },
        { "include": "#image" },
        { "include": "#link_inline" },
        { "include": "#link_ref" },
        { "include": "#extension_block" },
        { "include": "#extension_inline" },
        { "include": "#critic_add" },
        { "include": "#critic_del" },
        { "include": "#critic_sub" },
        { "include": "#critic_highlight" },
        { "include": "#critic_comment" },
        { "include": "#attributes" },
        { "include": "#bold_italic" },
        { "include": "#strong" },
        { "include": "#italic" },
        { "include": "#underline" },
        { "include": "#strike" },
        { "include": "#highlight" },
        { "include": "#superscript" },
        { "include": "#subscript" },
        { "include": "#mention" },
        { "include": "#tag" },
        { "include": "#autolink" },
        { "include": "#footnote_ref" },
        { "include": "#smart_typography" },
        { "include": "#escape" }
      ]
    },
    "escape": {
      "match": "\\\\[\\\\`*_{}\\[\\]()#+\\-.!~^/<>@%|=,]",
      "name": "constant.character.escape.carve"
    },
    "code_inline": {
      "match": "(`+)([^`]|[^`][\\s\\S]*?[^`])(\\1)",
      "captures": {
        "1": { "name": "punctuation.definition.raw.carve" },
        "2": { "name": "markup.raw.inline.carve" },
        "3": { "name": "punctuation.definition.raw.carve" }
      },
      "name": "markup.raw.inline.carve"
    },
    "image": {
      "match": "(!\\[)([^\\]]*)(\\])(\\()([^)\\s]+)(?:\\s+\"([^\"]*)\")?(\\))",
      "captures": {
        "1": { "name": "punctuation.definition.image.carve" },
        "2": { "name": "string.other.image.alt.carve" },
        "3": { "name": "punctuation.definition.image.carve" },
        "4": { "name": "punctuation.definition.link.carve" },
        "5": { "name": "markup.underline.link.image.carve" },
        "6": { "name": "string.other.link.title.carve" },
        "7": { "name": "punctuation.definition.link.carve" }
      }
    },
    "link_inline": {
      "match": "(\\[)([^\\]]+)(\\])(\\()([^)\\s]+)(?:\\s+\"([^\"]*)\")?(\\))",
      "captures": {
        "1": { "name": "punctuation.definition.link.carve" },
        "2": { "name": "string.other.link.title.carve" },
        "3": { "name": "punctuation.definition.link.carve" },
        "4": { "name": "punctuation.definition.link.carve" },
        "5": { "name": "markup.underline.link.carve" },
        "6": { "name": "string.other.link.description.carve" },
        "7": { "name": "punctuation.definition.link.carve" }
      }
    },
    "link_ref": {
      "match": "(\\[)([^\\]]+)(\\])(\\[)([^\\]]*)(\\])",
      "captures": {
        "1": { "name": "punctuation.definition.link.carve" },
        "2": { "name": "string.other.link.title.carve" },
        "3": { "name": "punctuation.definition.link.carve" },
        "4": { "name": "punctuation.definition.link.carve" },
        "5": { "name": "constant.other.reference.link.carve" },
        "6": { "name": "punctuation.definition.link.carve" }
      }
    },
    "extension_block": {
      "match": "^(:::)\\s+([a-zA-Z][\\w-]*)\\s+(.*)$",
      "captures": {
        "1": { "name": "punctuation.definition.extension.carve" },
        "2": { "name": "entity.name.function.extension.carve" },
        "3": { "name": "string.unquoted.extension.carve" }
      }
    },
    "extension_inline": {
      "match": "(:)([a-zA-Z][\\w-]*)(\\[)([^\\]]*)(\\])(\\{[^}]*\\})?",
      "captures": {
        "1": { "name": "punctuation.definition.extension.carve" },
        "2": { "name": "entity.name.function.extension.carve" },
        "3": { "name": "punctuation.definition.extension.carve" },
        "4": { "name": "string.unquoted.extension.carve" },
        "5": { "name": "punctuation.definition.extension.carve" },
        "6": { "name": "meta.attributes.carve" }
      }
    },
    "critic_add": {
      "match": "\\{\\+[^}]*\\+\\}",
      "name": "markup.inserted.carve"
    },
    "critic_del": {
      "match": "\\{-[^}]*-\\}",
      "name": "markup.deleted.carve"
    },
    "critic_sub": {
      "match": "\\{~[^}]*~\\}",
      "name": "markup.changed.carve"
    },
    "critic_highlight": {
      "match": "\\{=[^}]*=\\}",
      "name": "markup.highlight.critic.carve"
    },
    "critic_comment": {
      "match": "\\{#[^}]*#\\}",
      "name": "comment.block.critic.carve"
    },
    "attributes": {
      "match": "(\\{)([^}\\n]+)(\\})",
      "captures": {
        "1": { "name": "punctuation.definition.attributes.carve" },
        "2": { "name": "meta.attributes.carve" },
        "3": { "name": "punctuation.definition.attributes.carve" }
      },
      "name": "meta.attributes.carve"
    },
    "bold_italic": {
      "match": "(/\\*)([^*]+)(\\*/)",
      "captures": {
        "1": { "name": "punctuation.definition.bold-italic.carve" },
        "2": { "name": "markup.bold.italic.carve" },
        "3": { "name": "punctuation.definition.bold-italic.carve" }
      }
    },
    "strong": {
      "match": "(\\*)(?=\\S)([^*\\n]+?)(?<=\\S)(\\*)",
      "captures": {
        "1": { "name": "punctuation.definition.bold.carve" },
        "2": { "name": "markup.bold.carve" },
        "3": { "name": "punctuation.definition.bold.carve" }
      }
    },
    "italic": {
      "match": "(?<![\\w/])(/)(?=\\S)([^/\\n]+?)(?<=\\S)(/)(?![\\w/])",
      "captures": {
        "1": { "name": "punctuation.definition.italic.carve" },
        "2": { "name": "markup.italic.carve" },
        "3": { "name": "punctuation.definition.italic.carve" }
      }
    },
    "underline": {
      "match": "(?<![\\w_])(_)(?=\\S)([^_\\n]+?)(?<=\\S)(_)(?![\\w_])",
      "captures": {
        "1": { "name": "punctuation.definition.underline.carve" },
        "2": { "name": "markup.underline.text.carve" },
        "3": { "name": "punctuation.definition.underline.carve" }
      }
    },
    "strike": {
      "match": "(~)(?=\\S)([^~\\n]+?)(?<=\\S)(~)",
      "captures": {
        "1": { "name": "punctuation.definition.strike.carve" },
        "2": { "name": "markup.strikethrough.carve" },
        "3": { "name": "punctuation.definition.strike.carve" }
      }
    },
    "highlight": {
      "match": "(==)([^=\\n]+?)(==)",
      "captures": {
        "1": { "name": "punctuation.definition.highlight.carve" },
        "2": { "name": "markup.highlight.carve" },
        "3": { "name": "punctuation.definition.highlight.carve" }
      }
    },
    "superscript": {
      "match": "(\\^)(?=\\S)([^\\s^\\n]+?)(\\^)",
      "captures": {
        "1": { "name": "punctuation.definition.superscript.carve" },
        "2": { "name": "markup.superscript.carve" },
        "3": { "name": "punctuation.definition.superscript.carve" }
      }
    },
    "subscript": {
      "match": "(,,)(?=\\S)([^,\\n]+?)(,,)",
      "captures": {
        "1": { "name": "punctuation.definition.subscript.carve" },
        "2": { "name": "markup.subscript.carve" },
        "3": { "name": "punctuation.definition.subscript.carve" }
      }
    },
    "mention": {
      "match": "(?<![\\w])(@)([a-zA-Z][\\w-]*)",
      "captures": {
        "1": { "name": "punctuation.definition.mention.carve" },
        "2": { "name": "variable.other.mention.carve" }
      }
    },
    "tag": {
      "match": "(?<![\\w])(#)([a-zA-Z][\\w-]*)",
      "captures": {
        "1": { "name": "punctuation.definition.tag.carve" },
        "2": { "name": "variable.other.tag.carve" }
      }
    },
    "autolink": {
      "match": "(<)([a-zA-Z][a-zA-Z0-9+.\\-]*:[^>\\s]+)(>)",
      "captures": {
        "1": { "name": "punctuation.definition.link.carve" },
        "2": { "name": "markup.underline.link.carve" },
        "3": { "name": "punctuation.definition.link.carve" }
      }
    },
    "footnote_ref": {
      "match": "(\\[)(\\^)([^\\]]+)(\\])",
      "captures": {
        "1": { "name": "punctuation.definition.footnote.carve" },
        "2": { "name": "punctuation.definition.footnote.carve" },
        "3": { "name": "constant.other.footnote.carve" },
        "4": { "name": "punctuation.definition.footnote.carve" }
      }
    },
    "smart_typography": {
      "match": "(---|--|\\.\\.\\.|<->|->|<-|<=|>=)",
      "name": "constant.other.smart_typography.carve"
    }
  }
}
