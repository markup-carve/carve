{
  "name": "carve-docs",
  "version": "0.1.14",
  "private": true,
  "type": "module",
  "description": "Documentation site for Carve, a lightweight markup language for documents and the web",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "spec2:data": "node scripts/spec2-data-check.mjs",
    "spec2:unicode": "node scripts/spec2-unicode.mjs --check",
    "expected:check": "node scripts/expected-check.mjs",
    "docs:dev": "npm run docs:pages && vitepress dev docs",
    "docs:build": "node --test tests/docs-controlled-vocabulary.test.mjs && node scripts/publish-schema.mjs && npm run docs:pages && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:samples:check": "node scripts/docs-samples-check.mjs",
    "docs:layout:check": "node scripts/docs-layout-check.mjs",
    "docs:pages": "node scripts/generate-example-pages.mjs",
    "docs:upgrade:check": "node scripts/docs-upgrade-page.mjs",
    "docs:upgrade:write": "node scripts/docs-upgrade-page.mjs --write",
    "changelog:check": "node scripts/changelog-completeness.mjs",
    "bump-carve-pin": "node scripts/bump-carve-pin.mjs",
    "sync-carve-wasm": "node scripts/sync-carve-wasm.mjs",
    "links:check": "node scripts/check-external-links.mjs",
    "lint:mermaid": "mermaid-lint --quiet",
    "lint:parity": "node scripts/lint-parity.mjs",
    "test": "node scripts/run-tests.mjs"
  },
  "devDependencies": {
    "@markup-carve/carve": "github:markup-carve/carve-js#a5a7bbd2c474873b82c3cc01bda2e6948adb3473",
    "@markup-carve/carve-css": "github:markup-carve/carve-css#ad402980774f107c239cc03afc13f8e18c634eb8",
    "@markup-carve/carve-grammars": "github:markup-carve/carve-grammars#7bad2fb97636330759625c61cb60a36ec4ceee95",
    "@markup-carve/vite-plugin-carve": "git+https://github.com/markup-carve/vite-plugin-carve.git#ac9ff163a480e602dd066abb8e0b9bd06b9fe3b7",
    "@mermaid-lint/cli": "^0.53.1",
    "ajv": "^8.20.0",
    "commonmark": "^0.31.2",
    "markdown-it-container": "^4.0.0",
    "shiki": "^2.5.0",
    "vitepress": "^1.5.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@markup-carve/carve-lsp": "github:markup-carve/carve-lsp#d0875ced05f1c7288719553b66cecf0eb70bbc6f",
    "chart.js": "^4.5.1",
    "mermaid": "^11.15.0"
  },
  "overrides": {
    "@markup-carve/carve": "$@markup-carve/carve"
  }
}
