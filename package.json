{
  "name": "carve-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Documentation site for Carve, a post-Markdown markup language",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "corpus:build": "node scripts/generate-corpus.mjs",
    "compare:impls": "node scripts/compare-impls.mjs",
    "sync-carve-lib": "node scripts/sync-carve-lib.mjs",
    "sync-carve-wasm": "node scripts/sync-carve-wasm.mjs",
    "test": "node --test tests/corpus.test.mjs tests/optional-corpus.test.mjs tests/normativity.test.mjs tests/examples.test.mjs",
    "test:conformance": "npm run corpus:build && npm test",
    "examples:snapshot": "UPDATE_EXAMPLES=1 node --test tests/examples.test.mjs"
  },
  "devDependencies": {
    "@markup-carve/vite-plugin-carve": "git+https://github.com/markup-carve/vite-plugin-carve.git",
    "markdown-it-container": "^4.0.0",
    "vitepress": "^1.5.0"
  },
  "dependencies": {
    "mermaid": "^11.15.0"
  }
}
