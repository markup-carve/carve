{
  "name": "carve-docs",
  "version": "0.1.13",
  "private": true,
  "type": "module",
  "description": "Documentation site for Carve, a lightweight markup language for documents and the web",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "spec:write": "node scripts/spec-source.mjs --write",
    "spec:check": "node scripts/spec-source.mjs --check && node scripts/grammar-character-check.mjs",
    "spec:rules:write": "node scripts/spec-rule-index.mjs --write",
    "rules:coverage": "node scripts/rule-coverage.mjs",
    "spec:rules:check": "node scripts/spec-rules.mjs --check && node scripts/spec-rule-index.mjs --check && node scripts/spec-references.mjs",
    "roles:write": "node scripts/generate-node-roles.mjs",
    "roles:check": "node scripts/generate-node-roles.mjs --check",
    "html-import:check": "node --test tests/html-import-contract.check.mjs",
    "escape:check": "node --test tests/escape-corpus.check.mjs",
    "docs:dev": "node scripts/publish-schema.mjs && npm run docs:pages && vitepress dev docs",
    "docs:build": "node --test tests/docs-controlled-vocabulary.test.mjs tests/ast-schema.test.mjs && node scripts/publish-schema.mjs && npm run docs:pages && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "corpus:build": "node scripts/generate-corpus.mjs",
    "docs:pages": "node scripts/generate-example-pages.mjs && node scripts/spec-rule-index.mjs --write",
    "deps:map": "node tools/dependency-map.mjs",
    "compare:impls": "node scripts/compare-impls.mjs",
    "compare:convert": "node scripts/compare-impls.mjs --corpus=convert --fail-on-diff",
    "compare:counts": "node scripts/compare-impls.mjs --counts-only",
    "compare:run-corpus": "node scripts/comparison-run-corpus.mjs",
    "compare:report": "node scripts/check-compare-report.mjs",
    "parity:check": "node scripts/parity-check.mjs",
    "lint:parity": "node scripts/lint-corpus-check.mjs",
    "claims:check": "node scripts/engine-claims.mjs",
    "degradation:check": "node scripts/degradation-claims.mjs",
    "migration:evidence": "node scripts/migration-evidence-claims.mjs",
    "import:report": "node scripts/import-report-claims.mjs",
    "fmt:check": "node scripts/fmt-fixture-claims.mjs",
    "fuzz:impls": "node scripts/fuzz-impls.mjs",
    "pack:write": "node scripts/conformance-pack.mjs --write",
    "pack:check": "node scripts/conformance-pack.mjs --check",
    "combinatorial:check": "node scripts/combinatorial-check.mjs",
    "block-family:check": "node scripts/block-family-differential.mjs",
    "property:check": "node scripts/property-check.mjs",
    "ast:check": "node scripts/ast-conformance.mjs",
    "shape:table": "node scripts/shape-table.mjs",
    "core:check": "node scripts/formal-core-check.mjs",
    "grammar:reach": "node scripts/grammar-reachability-check.mjs",
    "grammar:productions": "node scripts/production-reachability.mjs",
    "grammar:duplicates": "node scripts/duplicate-productions.mjs",
    "engine:report": "node scripts/engine-report.mjs",
    "normative:check": "node scripts/normative-page-audit.mjs",
    "declarations:check": "node scripts/declaration-audit.mjs",
    "fleet:pin": "node scripts/fleet-spec-pin-check.mjs",
    "declarations:pr": "node scripts/declaration-audit.mjs --mode=per-pr",
    "changelog:check": "node scripts/changelog-completeness.mjs",
    "bump-carve-pin": "node scripts/bump-carve-pin.mjs",
    "sync-carve-wasm": "node scripts/sync-carve-wasm.mjs",
    "links:check": "node scripts/check-external-links.mjs",
    "lint:mermaid": "mermaid-lint --quiet",
    "test": "node scripts/run-tests.mjs",
    "test:conformance": "npm run corpus:build && npm test",
    "examples:snapshot": "UPDATE_EXAMPLES=1 node --test tests/examples.test.mjs",
    "include:gen": "node scripts/gen-include-conformance.mjs",
    "test:includes": "node --test tests/include-conformance.proof.mjs tests/lint-include-conformance.proof.mjs",
    "test:quality-cases": "node scripts/check-quality-cases.mjs",
    "import:compare": "node scripts/import-comparison.mjs import",
    "ast:ingest": "node scripts/import-comparison.mjs ingest",
    "roundtrip:structure": "node scripts/roundtrip-structure.mjs"
  },
  "devDependencies": {
    "@djot/djot": "^0.3.2",
    "@markup-carve/carve": "github:markup-carve/carve-js#0f5f449ac2ecf7189ba54e19e8130b7f9d0899dd",
    "@markup-carve/carve-css": "^0.1.9",
    "@markup-carve/carve-grammars": "github:markup-carve/carve-grammars#ac2eea2f5bd1ad17bacb7386b9188b50dd7cb5fa",
    "@markup-carve/vite-plugin-carve": "git+https://github.com/markup-carve/vite-plugin-carve.git#0b3552413ff1de6302921c8144497931fbd0124f",
    "@mermaid-lint/cli": "^0.53.1",
    "ajv": "^8.20.0",
    "commonmark": "^0.31.2",
    "gfm-wasm": "1.0.1",
    "markdown-it-container": "^4.0.0",
    "ohm-js": "^17.5.0",
    "parse5": "^7.3.0",
    "shiki": "^2.5.0",
    "vitepress": "^1.5.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@markup-carve/carve-lsp": "^0.1.15",
    "chart.js": "^4.5.1",
    "mermaid": "^11.15.0"
  },
  "overrides": {
    "@markup-carve/carve": "$@markup-carve/carve"
  }
}
